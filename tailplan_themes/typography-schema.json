{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailplan typography preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "tokens"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font-heading",
        "font-body"
      ],
      "properties": {
        "font-heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:(?:[A-Za-z-][A-Za-z0-9-]*|\"[A-Za-z][A-Za-z0-9 -]*\"), )*(?:serif|sans-serif|system-ui)$"
        },
        "font-body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:(?:[A-Za-z-][A-Za-z0-9-]*|\"[A-Za-z][A-Za-z0-9 -]*\"), )*(?:serif|sans-serif|system-ui)$"
        }
      }
    }
  }
}
