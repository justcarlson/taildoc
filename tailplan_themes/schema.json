{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailplan palette v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "variant",
    "mode",
    "source",
    "tokens"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "variant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mode": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "revision",
        "license",
        "licenseFile"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "licenseFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "text",
        "heading",
        "accent",
        "surface",
        "border",
        "muted",
        "code-background",
        "code-text"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "heading": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "code-background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "code-text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    }
  }
}
