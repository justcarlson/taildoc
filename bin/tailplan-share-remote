#!/usr/bin/env python3
"""Publish a local artifact through a remote Tailplan host over OpenSSH."""
from __future__ import annotations

import argparse
import json
import os
import re
import runpy
import shlex
import subprocess
import sys
import tempfile
from collections.abc import Callable
from pathlib import Path

DEFAULT_TARGET = "tailplan-server"
TARGET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
DRAFT_RE = re.compile(r"^[a-z0-9]{6,32}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$")
REMOTE_DIR_RE = re.compile(r"^/tmp/tailplan-upload\.[A-Za-z0-9]{8}$")
VISIBILITIES = ("private", "workspace", "authenticated", "link")
GRANT_ROLES = ("viewer", "editor")
# These match the publish guard on the server, so a value it refuses fails here first.
WORKSPACE_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,62}")
# An email needs a dotted domain. A dot-free login such as alice@github is a
# Tailscale login: use --grant-tailscale for it.
EMAIL_ARG_RE = re.compile(
    r"[A-Za-z0-9_%+'][A-Za-z0-9._%+'-]{0,63}"
    r"@(?=[A-Za-z0-9.-]{3,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+"
)
TAILSCALE_LOGIN_ARG_RE = re.compile(
    r"[A-Za-z0-9_%+'][A-Za-z0-9._%+'-]{0,63}@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?"
)
GROUP_ARG_RE = re.compile(r"[A-Za-z0-9/_][A-Za-z0-9 _./:@+-]{0,254}")
SHARING_PATTERNS = {
    "--workspace": WORKSPACE_RE,
    "--grant-email": EMAIL_ARG_RE, "--revoke-email": EMAIL_ARG_RE,
    "--grant-tailscale": TAILSCALE_LOGIN_ARG_RE, "--revoke-tailscale": TAILSCALE_LOGIN_ARG_RE,
    "--grant-group": GROUP_ARG_RE, "--revoke-group": GROUP_ARG_RE,
}
TAG_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,31}")
MAX_TAGS = 10
LIST_VIEWS = ("active", "favorites", "living", "shared", "archived", "all")
LIST_SORTS = ("updated", "living", "favorited", "created", "title", "relevance")
REPO_ARG_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,127}")
QUERY_ARG_RE = re.compile(r"[^\x00-\x1f\x7f-]{1}[^\x00-\x1f\x7f]{0,199}")
Run = Callable[..., subprocess.CompletedProcess[str]]


def parse_tags(values: list[str]) -> list[str]:
    """Split comma-separated tag text, lowercase it, and check each tag. Raise ValueError."""
    tags: list[str] = []
    for value in values:
        for part in value.split(","):
            tag = part.strip().lower()
            if not tag:
                continue
            if TAG_RE.fullmatch(tag) is None:
                raise ValueError(f"Invalid tag {part.strip()!r}: use 1 to 32 letters, digits, dots, underscores, or hyphens.")
            if tag not in tags:
                tags.append(tag)
    if len(tags) > MAX_TAGS:
        raise ValueError(f"A draft holds at most {MAX_TAGS} tags.")
    return tags


def single_tag(value: str) -> str:
    """Return exactly one valid lowercase tag. Raise ValueError on empty text, a list, or a bad tag."""
    tag = value.strip().lower()
    if TAG_RE.fullmatch(tag) is None:
        raise ValueError(
            f"Invalid tag {value.strip()!r}: give one tag of 1 to 32 letters, digits, dots, underscores, or hyphens."
        )
    return tag


class _CheckedParser(argparse.ArgumentParser):
    """An argument parser that raises ValueError, so --json callers can report the failure."""

    def error(self, message: str):
        raise ValueError(message)


def _fail(exc: Exception, *, json_output: bool, prefix: str = "tailplan") -> int:
    """Report a local failure before any SSH call. Print JSON when the caller asked for it."""
    if json_output:
        try:
            return _load_library()["_emit_failure"](
                "usage", str(exc), json_output=True, stdout=sys.stdout, stderr=sys.stderr, exit_code=2,
            )
        except (RuntimeError, OSError, KeyError):
            pass
    print(f"{prefix}: {exc}", file=sys.stderr)
    return 2


def default_tags_from_env(environ=None) -> list[str]:
    """Read TAILPLAN_PROJECT and TAILPLAN_TAGS. Skip anything unusable. Never use the working folder."""
    environ = os.environ if environ is None else environ
    tags: list[str] = []
    for candidate in [environ.get("TAILPLAN_PROJECT", "")] + environ.get("TAILPLAN_TAGS", "").split(","):
        tag = re.sub(r"[^a-z0-9._-]+", "-", candidate.strip().lower())[:32].strip("-._")
        if TAG_RE.fullmatch(tag) and tag not in tags:
            tags.append(tag)
    return tags[:MAX_TAGS]


def tags_for_upload(tags: list[str], default_tags: list[str], *, new_draft: bool) -> list[str]:
    """Pick the tags to send. Default tags join only a new draft, so a re-upload keeps edited tags."""
    if new_draft and default_tags:
        return list(dict.fromkeys([*tags, *default_tags]))[:MAX_TAGS]
    return tags


def tag_arguments(tags: list[str]) -> list[str]:
    """Return --tag options as shell-quoted words. Raise ValueError on a bad tag."""
    words: list[str] = []
    for tag in parse_tags(tags):
        words.extend(["--tag", shlex.quote(tag)])
    return words


def safe_filename(path: Path) -> str:
    name = re.sub(r"[^A-Za-z0-9_.-]+", "-", path.name).strip("-.")
    return (name or "tailplan-draft.md")[:255]


def validate_target(target: str) -> None:
    if not TARGET_RE.fullmatch(target):
        raise ValueError(
            "SSH target must be a simple configured host alias containing only letters, "
            "numbers, dots, underscores, or hyphens."
        )


def validate_remote_dir(path: str) -> None:
    if not REMOTE_DIR_RE.fullmatch(path) or ".." in Path(path).parts:
        raise RuntimeError("Remote mktemp returned an unsafe path.")


def sharing_arguments(options: list[tuple[str, str | list[str] | None]]) -> list[str]:
    """Return remote sharing options as shell-quoted words. Raise ValueError on a bad value.

    Each value must match a strict pattern, and each word is also quoted,
    because OpenSSH joins the words into one remote shell command.
    """
    words: list[str] = []
    for option, value in options:
        values = value if isinstance(value, list) else ([] if value is None else [value])
        for item in values:
            if option == "--visibility":
                valid = item in VISIBILITIES
            elif option in {"--role", "--grant-role"}:
                valid = item in GRANT_ROLES
            else:
                valid = SHARING_PATTERNS[option].fullmatch(item) is not None
            if not valid:
                raise ValueError(f"{option} value is invalid: {item!r}")
            words.extend([option, shlex.quote(item)])
    return words


def share_file(
    source: Path,
    *,
    target: str,
    new: bool,
    draft: str | None,
    run: Run = subprocess.run,
    description: str | None = None,
    json_output: bool = False,
    metadata_path: Path | None = None,
    theme: str | None = None,
    document_type: str | None = None,
    layout: str | None = None,
    typography: str | None = None,
    slug: str | None = None,
    files_json_path: Path | None = None,
    sharing: list[tuple[str, str | list[str] | None]] | None = None,
    tags: list[str] | None = None,
    favorite: bool = False,
) -> subprocess.CompletedProcess[str]:
    source = source.expanduser().resolve()
    sharing_words = sharing_arguments(sharing or []) + tag_arguments(tags or [])
    if favorite:
        sharing_words.append("--favorite")
    if files_json_path is None and not source.is_file():
        raise FileNotFoundError(source)
    validate_target(target)
    if draft and not DRAFT_RE.fullmatch(draft):
        raise ValueError("Draft id must contain 6-32 lowercase letters or numbers.")
    if slug is not None and not SLUG_RE.fullmatch(slug):
        raise ValueError("Custom URL must contain 3-40 lowercase letters, numbers, or inner hyphens.")
    if new and slug is not None:
        raise ValueError("--new cannot be combined with --slug.")

    created = run(
        ["ssh", target, "mktemp", "-d", "/tmp/tailplan-upload.XXXXXXXX"],
        check=True,
        capture_output=True,
        text=True,
    )
    remote_dir = created.stdout.strip()
    validate_remote_dir(remote_dir)
    if files_json_path is not None:
        remote_path = f"{remote_dir}/pages.json"
        transfer_source = files_json_path
    else:
        remote_path = f"{remote_dir}/{safe_filename(source)}"
        transfer_source = source

    try:
        run(["scp", "-O", "--", str(transfer_source), f"{target}:{remote_path}"], check=True)
        if metadata_path:
            run(["scp", "-O", "--", str(metadata_path), f"{target}:{remote_dir}/provenance.json"], check=True)
        if files_json_path is not None:
            command = ["ssh", target, "tailplan-share", "--files-json", remote_path]
        else:
            command = ["ssh", target, "tailplan-share", remote_path]
        for option, value in (("--theme", theme), ("--document-type", document_type), ("--layout", layout), ("--typography", typography)):
            if value is not None:
                if not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", value):
                    raise ValueError("Invalid theme, document type, layout, or typography")
                command.extend([option, value])
        if new:
            command.append("--new")
        elif draft:
            command.extend(["--draft", draft])
        if slug is not None:
            command.extend(["--slug", slug])
        if json_output:
            command.append("--json")
        if description is not None:
            if len(description) > 1000 or any(ord(character) < 32 for character in description):
                raise ValueError("Description must contain at most 1000 characters without control characters.")
            command.extend(["--description", shlex.quote(description)])
        if metadata_path:
            command.extend(["--metadata-file", f"{remote_dir}/provenance.json"])
        command.extend(sharing_words)
        return run(command, check=True, capture_output=True, text=True)
    finally:
        run(
            ["ssh", target, "rm", "-rf", "--", remote_dir],
            check=False,
            capture_output=True,
            text=True,
        )


def _load_library() -> dict:
    library_path = Path(__file__).resolve().with_name("tailplan-publisher")
    if not library_path.exists():
        library_path = Path(__file__).resolve().with_name("tailplan-share")
    if library_path == Path(__file__).resolve():
        raise RuntimeError("Client helpers are missing. Run install-client.sh again.")
    return runpy.run_path(str(library_path))


def _remote_check(argv: list[str], target: str) -> int:
    parser = argparse.ArgumentParser(prog="tailplan check")
    parser.add_argument("file", nargs="?")
    parser.add_argument("--slug")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    validate_target(target)
    library = _load_library()
    cli_version = library["CLI_VERSION"]
    slug_value = args.slug.strip().lower() if args.slug is not None else None
    if slug_value is not None:
        problem = library["slug_problem"](slug_value)
        if problem is not None:
            report = {
                "cliVersion": cli_version,
                "apiUrl": f"ssh://{target}",
                "ok": False,
                "slug": {"slug": slug_value, "status": "unavailable", "message": problem},
            }
            if args.json:
                print(json.dumps(report, ensure_ascii=False))
            else:
                library["_print_check_report"](report)
            return 1
    if not args.file:
        cmd = ["ssh", target, "tailplan-share", "check"]
        if slug_value is not None:
            cmd.extend(["--slug", slug_value])
        if args.json:
            cmd.append("--json")
        completed = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if completed.returncode == 255:
            report = {
                "cliVersion": cli_version,
                "apiUrl": f"ssh://{target}",
                "ok": False,
                "offline": True,
                "networkError": f"Could not reach SSH target {target}.",
            }
            if slug_value is not None:
                report["slug"] = {
                    "slug": slug_value,
                    "status": "unchecked",
                    "message": "Availability was not checked offline.",
                }
            if args.json:
                print(json.dumps(report, ensure_ascii=False))
            else:
                library["_print_check_report"](report)
            return 1
        if completed.stdout:
            sys.stdout.write(completed.stdout)
        if completed.stderr:
            sys.stderr.write(completed.stderr)
        return completed.returncode
    source = Path(args.file).expanduser().resolve()
    if not source.exists():
        return library["_emit_failure"](
            "file", f"Path does not exist: {source}",
            json_output=args.json, stdout=sys.stdout, stderr=sys.stderr, exit_code=2,
        )
    if source.is_file() and source.suffix.lower() not in {".html", ".htm", ".md", ".txt"}:
        return library["_emit_failure"](
            "file", "Unsupported file type; use .md, .txt, .html, .htm, or a folder.",
            json_output=args.json, stdout=sys.stdout, stderr=sys.stderr, exit_code=2,
        )
    try:
        offline_pages: list[dict]
        folder_pages: list[dict] | None = None
        if source.is_dir():
            folder_pages = library["read_html_folder"](source)
            if not folder_pages:
                return library["_emit_failure"](
                    "file", f"No .html files found in {source}",
                    json_output=args.json, stdout=sys.stdout, stderr=sys.stderr, exit_code=2,
                )
            offline_pages = folder_pages
        elif source.suffix.lower() in {".html", ".htm"}:
            offline_pages = [{"path": "index.html", "html": source.read_bytes().decode("utf-8")}]
        else:
            text = source.read_text(encoding="utf-8")
            rendered = library["html_document"](
                library["title_from_content"](source, text),
                library["markdown_to_body"](text),
                source.name,
            )
            offline_pages = [{"path": "index.html", "html": rendered}]
    except (OSError, UnicodeError):
        return library["_emit_failure"](
            "file", "Input file is not valid UTF-8 or could not be read.",
            json_output=args.json, stdout=sys.stdout, stderr=sys.stderr, exit_code=2,
        )
    with tempfile.TemporaryDirectory(prefix="tailplan-check-") as temporary:
        files_json = None
        if folder_pages is not None:
            files_json = Path(temporary) / "pages.json"
            files_json.write_text(
                json.dumps({"filename": source.name, "files": folder_pages}, ensure_ascii=False),
                encoding="utf-8",
            )
        created = subprocess.run(
            ["ssh", target, "mktemp", "-d", "/tmp/tailplan-upload.XXXXXXXX"],
            capture_output=True, text=True, check=False,
        )
        if created.returncode != 0:
            local = library["validate_upload_offline"](offline_pages)
            report = {
                "cliVersion": cli_version,
                "apiUrl": f"ssh://{target}",
                "path": str(source),
                "ok": False,
                "offline": True,
                "networkError": f"Could not reach SSH target {target}.",
                "markupOk": local["ok"],
                "totalBytes": local["totalBytes"],
                "pages": local["pages"],
                "issues": local["issues"],
                "errors": local["errors"],
                "warnings": local["warnings"],
            }
            if slug_value is not None:
                report["slug"] = {
                    "slug": slug_value,
                    "status": "unchecked",
                    "message": "Availability was not checked offline.",
                }
            if args.json:
                print(json.dumps(report, ensure_ascii=False))
            else:
                library["_print_check_report"](report)
            return 1
        remote_dir = created.stdout.strip()
        validate_remote_dir(remote_dir)
        remote_path = f"{remote_dir}/pages.json" if files_json else f"{remote_dir}/{safe_filename(source)}"
        try:
            subprocess.run(["scp", "-O", "--", str(files_json or source), f"{target}:{remote_path}"], check=True)
            cmd = ["ssh", target, "tailplan-share", "check"]
            if files_json:
                cmd.extend(["--files-json", remote_path])
            else:
                cmd.append(remote_path)
            if slug_value is not None:
                cmd.extend(["--slug", slug_value])
            cmd.append("--json")
            completed = subprocess.run(cmd, capture_output=True, text=True, check=False)
            if completed.stdout.strip():
                try:
                    report = json.loads(completed.stdout)
                except ValueError:
                    report = None
                if isinstance(report, dict) and "error" in report:
                    return library["_emit_failure"](
                        report.get("category", "management"),
                        str(report["error"]),
                        json_output=args.json,
                        stdout=sys.stdout,
                        stderr=sys.stderr,
                        exit_code=completed.returncode or 1,
                        code=report.get("code"),
                    )
                if isinstance(report, dict) and "ok" in report:
                    report["path"] = str(source)
                    if args.json:
                        print(json.dumps(report, ensure_ascii=False))
                    else:
                        library["_print_check_report"](report)
                    if completed.stderr:
                        sys.stderr.write(completed.stderr)
                    return completed.returncode
            if completed.stdout:
                sys.stdout.write(completed.stdout)
            if completed.stderr:
                sys.stderr.write(completed.stderr)
            return completed.returncode
        finally:
            subprocess.run(["ssh", target, "rm", "-rf", "--", remote_dir], check=False, capture_output=True)


def _remote_share(argv: list[str], target: str) -> int:
    """Show or change who can read a draft on the remote server."""
    parser = argparse.ArgumentParser(prog="tailplan share", description="Show or change who can read a draft")
    parser.add_argument("draft")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--visibility", choices=VISIBILITIES)
    parser.add_argument("--workspace")
    parser.add_argument("--role", choices=GRANT_ROLES)
    for kind, metavar in (("email", "EMAIL"), ("tailscale", "LOGIN"), ("group", "GROUP")):
        parser.add_argument(f"--grant-{kind}", action="append", default=[], metavar=metavar)
        parser.add_argument(f"--revoke-{kind}", action="append", default=[], metavar=metavar)
    args = parser.parse_args(argv)
    validate_target(target)
    ref = _load_library()["parse_draft_ref"](args.draft)
    command = ["ssh", target, "tailplan-share", "share", shlex.quote(ref)]
    if args.json:
        command.append("--json")
    command.extend(sharing_arguments([
        ("--visibility", args.visibility), ("--workspace", args.workspace), ("--role", args.role),
        ("--grant-email", args.grant_email), ("--grant-tailscale", args.grant_tailscale),
        ("--grant-group", args.grant_group), ("--revoke-email", args.revoke_email),
        ("--revoke-tailscale", args.revoke_tailscale), ("--revoke-group", args.revoke_group),
    ]))
    return subprocess.run(command, check=False).returncode


def _checked_value(option: str, value: str | None, pattern: re.Pattern[str]) -> str | None:
    if value is not None and pattern.fullmatch(value) is None:
        raise ValueError(f"{option} value is invalid: {value!r}")
    return value


def _remote_list(argv: list[str], target: str) -> int:
    """List drafts on the remote server. Check every filter before the SSH call."""
    parser = _CheckedParser(prog="tailplan list")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--tag")
    parser.add_argument("--view", choices=LIST_VIEWS)
    parser.add_argument("--q")
    parser.add_argument("--sort", choices=LIST_SORTS)
    parser.add_argument("--dir", choices=("asc", "desc"))
    parser.add_argument("--repo")
    parser.add_argument("--archived", action="store_true")
    args = parser.parse_args(argv)
    validate_target(target)
    command = ["ssh", target, "tailplan-share", "list"]
    if args.json:
        command.append("--json")
    if args.tag is not None:
        command.extend(["--tag", shlex.quote(single_tag(args.tag))])
    for option, value, pattern in (
        ("--view", args.view, None), ("--sort", args.sort, None), ("--dir", args.dir, None),
        ("--q", args.q, QUERY_ARG_RE), ("--repo", args.repo, REPO_ARG_RE),
    ):
        if value is not None:
            if pattern is not None:
                _checked_value(option, value, pattern)
            command.extend([option, shlex.quote(value)])
    if args.archived:
        command.append("--archived")
    return subprocess.run(command, check=False).returncode


def _remote_tag(argv: list[str], target: str) -> int:
    """Add, remove, or replace tags of a draft on the remote server."""
    parser = _CheckedParser(prog="tailplan tag")
    parser.add_argument("draft")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--add", action="append", default=[])
    parser.add_argument("--remove", action="append", default=[])
    parser.add_argument("--set", dest="set_tags")
    rewritten: list[str] = []
    after_value = False
    for token in argv:
        if after_value:
            rewritten.append(token)
            after_value = False
        elif token in {"--add", "--remove", "--set"}:
            rewritten.append(token)
            after_value = True
        elif token.startswith("+") and len(token) > 1:
            rewritten.append("--add=" + token[1:])
        elif token.startswith("-") and not token.startswith("--") and len(token) > 1 and token != "-h":
            rewritten.append("--remove=" + token[1:])
        else:
            rewritten.append(token)
    args = parser.parse_args(rewritten)
    validate_target(target)
    add, remove = parse_tags(args.add), parse_tags(args.remove)
    replace = parse_tags([args.set_tags]) if args.set_tags is not None else None
    if not add and not remove and replace is None:
        raise ValueError("Give +tag, -tag, or --set a,b to change tags.")
    ref = _load_library()["parse_draft_ref"](args.draft)
    command = ["ssh", target, "tailplan-share", "tag", shlex.quote(ref)]
    for option, tags in (("--add", add), ("--remove", remove)):
        for tag in tags:
            command.extend([option, shlex.quote(tag)])
    if replace is not None:
        command.extend(["--set", shlex.quote(",".join(replace))])
    if args.json:
        command.append("--json")
    return subprocess.run(command, check=False).returncode


def _remote_archive(command: str, argv: list[str], target: str) -> int:
    """Archive or restore one draft. Accept only a draft reference and --json."""
    parser = _CheckedParser(prog=f"tailplan {command}")
    parser.add_argument("draft")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    validate_target(target)
    ref = _load_library()["parse_draft_ref"](args.draft)
    words = ["ssh", target, "tailplan-share", command, shlex.quote(ref)]
    if args.json:
        words.append("--json")
    return subprocess.run(words, check=False).returncode


def _slug_may_name_existing_draft(target: str, slug: str) -> bool:
    """Return False only when the host says the slug is free. A failed check counts as taken."""
    try:
        completed = subprocess.run(
            ["ssh", target, "tailplan-share", "check", "--slug", shlex.quote(slug), "--json"],
            capture_output=True, text=True, check=False,
        )
        report = json.loads(completed.stdout)
        return not (isinstance(report, dict) and report.get("slug", {}).get("status") == "available")
    except (OSError, ValueError, AttributeError):
        return True


def _remote_download(argv: list[str], target: str) -> int:
    parser = argparse.ArgumentParser(prog="tailplan download")
    parser.add_argument("draft")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    library = _load_library()
    try:
        validate_target(target)
        ref = library["parse_draft_ref"](args.draft)
        completed = subprocess.run(
            ["ssh", target, "tailplan-share", "download", ref, "--print-source"],
            capture_output=True, text=True, check=False,
        )
        if completed.returncode != 0:
            detail = (completed.stderr or completed.stdout or "Remote download failed.").strip()
            return library["_emit_failure"](
                "management", detail,
                json_output=args.json, stdout=sys.stdout, stderr=sys.stderr,
                exit_code=completed.returncode or 1,
            )
        source = json.loads(completed.stdout)
        extra_args = ["--target", target] if target != DEFAULT_TARGET else []
        receipt = library["write_downloaded_source"](
            source,
            base_url=f"ssh://{target}",
            state_dir=Path.home() / ".tailplan",
            upload_extra_args=extra_args,
        )
        if args.json:
            print(json.dumps(receipt, ensure_ascii=False))
        else:
            count = len(receipt["pages"])
            label = f"{count} page" if count == 1 else f"{count} pages"
            print(f"Downloaded {receipt['path']} ({label}, v{receipt['versionNumber']})")
            print(f"Upload: {receipt['uploadCommand']}")
        return 0
    except (ValueError, RuntimeError, OSError) as exc:
        return library["_emit_failure"](
            "management", str(exc),
            json_output=args.json, stdout=sys.stdout, stderr=sys.stderr, exit_code=2,
        )


def main() -> int:
    argv = sys.argv[1:]
    target = os.getenv("TAILPLAN_SSH_TARGET", DEFAULT_TARGET)
    if "--target" in argv:
        index = argv.index("--target")
        if index + 1 >= len(argv):
            print("--target requires an SSH alias", file=sys.stderr)
            return 2
        target = argv[index + 1]
        argv = argv[:index] + argv[index + 2:]
    if argv and argv[0] in {"list", "tag", "archive", "unarchive"}:
        try:
            if argv[0] == "list":
                return _remote_list(argv[1:], target)
            if argv[0] == "tag":
                return _remote_tag(argv[1:], target)
            return _remote_archive(argv[0], argv[1:], target)
        except (ValueError, RuntimeError, OSError) as exc:
            return _fail(exc, json_output="--json" in argv[1:])
    if argv and argv[0] in {
        "whoami", "history", "disable", "enable", "delete",
        "favorite", "unfavorite", "keys", "themes", "typography",
    }:
        try:
            validate_target(target)
            forwarded = list(argv)
            if forwarded[0] in {"history", "disable", "enable", "delete", "favorite", "unfavorite"}:
                library = _load_library()
                idx = 1
                while idx < len(forwarded):
                    if forwarded[idx] == "--reason":
                        idx += 2
                        continue
                    if forwarded[idx].startswith("-"):
                        idx += 1
                        continue
                    forwarded[idx] = library["parse_draft_ref"](forwarded[idx])
                    break
            return subprocess.run(["ssh", target, "tailplan-share", *map(shlex.quote, forwarded)], check=False).returncode
        except (ValueError, RuntimeError, OSError) as exc:
            print(f"tailplan: {exc}", file=sys.stderr)
            return 2
    if argv and argv[0] == "share":
        try:
            return _remote_share(argv[1:], target)
        except (ValueError, RuntimeError, OSError) as exc:
            print(f"tailplan: {exc}", file=sys.stderr)
            return 2
    if argv and argv[0] == "check":
        try:
            return _remote_check(argv[1:], target)
        except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as exc:
            print(f"tailplan: {exc}", file=sys.stderr)
            return 2
    if argv and argv[0] == "download":
        try:
            return _remote_download(argv[1:], target)
        except (ValueError, RuntimeError, OSError) as exc:
            print(f"tailplan: {exc}", file=sys.stderr)
            return 2
    if argv and argv[0] == "upload":
        argv = argv[1:]
    parser = argparse.ArgumentParser(
        description="Publish a local Markdown, text, HTML file, or HTML folder through a remote Tailplan server."
    )
    parser.add_argument("file", help="Path to .md, .txt, .html file, or HTML folder")
    parser.add_argument(
        "--target",
        default=target,
        help=f"Configured SSH host alias (default: {DEFAULT_TARGET})",
    )
    version = parser.add_mutually_exclusive_group()
    version.add_argument("--new", action="store_true", help="Create a fresh Tailplan draft")
    version.add_argument("--draft", help="Update a specific Tailplan draft id")
    parser.add_argument("--slug", help="Set or update a custom URL slug")
    parser.add_argument("--theme")
    parser.add_argument("--document-type")
    parser.add_argument("--typography", help="Font preset ID; list with tailplan typography")
    parser.add_argument("--layout")
    parser.add_argument("--description")
    parser.add_argument("--workspace", help="Put a new draft in this workspace")
    parser.add_argument("--visibility", choices=VISIBILITIES, help="Set who can read the draft")
    parser.add_argument("--grant-email", action="append", default=[], metavar="EMAIL")
    parser.add_argument("--grant-tailscale", action="append", default=[], metavar="LOGIN")
    parser.add_argument("--grant-group", action="append", default=[], metavar="GROUP")
    parser.add_argument("--grant-role", choices=GRANT_ROLES, default=None)
    parser.add_argument("--tag", action="append", default=[], metavar="TAG",
                        help="Tag the draft, such as a project name (repeatable or comma-separated)")
    parser.add_argument("--favorite", action="store_true", help="Pin the draft as a favorite")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    upload_sharing = [
        ("--workspace", args.workspace), ("--visibility", args.visibility),
        ("--grant-email", args.grant_email), ("--grant-tailscale", args.grant_tailscale),
        ("--grant-group", args.grant_group), ("--grant-role", args.grant_role),
    ]

    try:
        library = _load_library()
        source = Path(args.file).expanduser().resolve()
        validate_target(args.target)
        explicit_tags = parse_tags(args.tag)
        default_tags = default_tags_from_env()
        slug = args.slug.strip().lower() if args.slug is not None else None
        if args.new and slug is not None:
            raise ValueError("--new cannot be combined with --slug.")
        if slug is not None:
            problem = library["slug_problem"](slug)
            if problem is not None:
                raise ValueError(problem)
        state_dir = Path.home() / ".tailplan"
        legacy_mapping_path = state_dir / f"remote-{args.target}-drafts.json"
        remote_api_key = f"ssh://{args.target}"
        with library["source_publish_lock"](legacy_mapping_path, source), tempfile.TemporaryDirectory(prefix="tailplan-client-") as temporary:
            binding = library["find_draft_binding"](
                state_dir, remote_api_key, source, legacy_mapping_path=legacy_mapping_path
            )
            if args.new:
                selected = None
            elif args.draft:
                selected = args.draft
            else:
                selected = binding["draftId"] if binding else None
            slug_check: list[bool] = []

            def creates_draft(selected_id: str | None) -> bool:
                """Tell whether this upload makes a new draft, so env default tags may apply."""
                if selected_id is not None:
                    return False
                if slug is None or not default_tags:
                    return True
                if not slug_check:
                    slug_check.append(_slug_may_name_existing_draft(args.target, slug))
                return not slug_check[0]

            provenance_cwd = source if source.is_dir() else source.parent
            metadata_path = Path(temporary) / "provenance.json"
            metadata_path.write_text(json.dumps(library["collect_provenance"](provenance_cwd)), encoding="utf-8")
            files_json_path = None
            if source.is_dir():
                pages = library["read_html_folder"](source)
                if not pages:
                    raise FileNotFoundError(f"No .html files found in {source}")
                files_json_path = Path(temporary) / "pages.json"
                files_json_path.write_text(
                    json.dumps({"filename": source.name, "files": pages}, ensure_ascii=False),
                    encoding="utf-8",
                )
            try:
                result = share_file(
                    source, target=args.target, new=args.new, draft=selected,
                    description=args.description, json_output=True, metadata_path=metadata_path,
                    theme=args.theme, document_type=args.document_type, layout=args.layout,
                    typography=args.typography, slug=slug, files_json_path=files_json_path,
                    sharing=upload_sharing, favorite=args.favorite,
                    tags=tags_for_upload(explicit_tags, default_tags, new_draft=creates_draft(selected)),
                )
            except subprocess.CalledProcessError as exc:
                try:
                    err_obj = json.loads(exc.stdout)
                    stale = err_obj.get("category") == "missing draft"
                    slug_mismatch = (
                        slug is not None
                        and err_obj.get("category") == "conflict"
                        and (
                            err_obj.get("code") == "slug_names_other_draft"
                            or "already names draft" in str(err_obj.get("error", ""))
                        )
                    )
                except (TypeError, ValueError):
                    stale = False
                    slug_mismatch = False
                if args.draft or not selected or (not stale and not slug_mismatch):
                    raise
                result = share_file(
                    source, target=args.target, new=(not slug_mismatch and slug is None), draft=None,
                    description=args.description, json_output=True, metadata_path=metadata_path,
                    theme=args.theme, document_type=args.document_type, layout=args.layout,
                    typography=args.typography, slug=slug, files_json_path=files_json_path,
                    sharing=upload_sharing, favorite=args.favorite,
                    tags=tags_for_upload(explicit_tags, default_tags, new_draft=creates_draft(None)),
                )
            value = json.loads(result.stdout)
            if not isinstance(value, dict) or value.get("ok") is not True:
                raise RuntimeError("Publisher returned an invalid response.")
            library["save_draft_binding"](state_dir, remote_api_key, source, value)
            return library["_emit_success"](value, json_output=args.json, stdout=sys.stdout, stderr=sys.stderr)
    except (FileNotFoundError, ValueError, RuntimeError, KeyError) as exc:
        return _fail(exc, json_output=args.json, prefix="tailplan-share")
    except subprocess.CalledProcessError as exc:
        if exc.stdout:
            print(exc.stdout, end="", file=sys.stdout)
        if exc.stderr:
            print(exc.stderr, end="", file=sys.stderr)
        print(f"tailplan-share: remote publish failed with exit {exc.returncode}", file=sys.stderr)
        return exc.returncode or 1

if __name__ == "__main__":
    raise SystemExit(main())
