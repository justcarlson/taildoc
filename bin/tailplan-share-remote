#!/usr/bin/env python3
"""Publish a local artifact through a remote Tailplan host over OpenSSH."""
from __future__ import annotations

import argparse
import json
import os
import re
import runpy
import shlex
import subprocess
import sys
import tempfile
from collections.abc import Callable
from pathlib import Path

DEFAULT_TARGET = "tailplan-server"
TARGET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
DRAFT_RE = re.compile(r"^[a-z0-9]{6,32}$")
REMOTE_DIR_RE = re.compile(r"^/tmp/tailplan-upload\.[A-Za-z0-9]{8}$")
Run = Callable[..., subprocess.CompletedProcess[str]]


def safe_filename(path: Path) -> str:
    name = re.sub(r"[^A-Za-z0-9_.-]+", "-", path.name).strip("-.")
    return (name or "tailplan-draft.md")[:255]


def validate_target(target: str) -> None:
    if not TARGET_RE.fullmatch(target):
        raise ValueError(
            "SSH target must be a simple configured host alias containing only letters, "
            "numbers, dots, underscores, or hyphens."
        )


def validate_remote_dir(path: str) -> None:
    if not REMOTE_DIR_RE.fullmatch(path) or ".." in Path(path).parts:
        raise RuntimeError("Remote mktemp returned an unsafe path.")


def share_file(
    source: Path,
    *,
    target: str,
    new: bool,
    draft: str | None,
    run: Run = subprocess.run,
    description: str | None = None,
    json_output: bool = False,
    metadata_path: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    source = source.expanduser().resolve()
    if not source.is_file():
        raise FileNotFoundError(source)
    validate_target(target)
    if draft and not DRAFT_RE.fullmatch(draft):
        raise ValueError("Draft id must contain 6-32 lowercase letters or numbers.")

    created = run(
        ["ssh", target, "mktemp", "-d", "/tmp/tailplan-upload.XXXXXXXX"],
        check=True,
        capture_output=True,
        text=True,
    )
    remote_dir = created.stdout.strip()
    validate_remote_dir(remote_dir)
    remote_path = f"{remote_dir}/{safe_filename(source)}"

    try:
        run(["scp", "-O", "--", str(source), f"{target}:{remote_path}"], check=True)
        if metadata_path:
            run(["scp", "-O", "--", str(metadata_path), f"{target}:{remote_dir}/provenance.json"], check=True)
        command = ["ssh", target, "tailplan-share", remote_path]
        if new:
            command.append("--new")
        elif draft:
            command.extend(["--draft", draft])
        if json_output:
            command.append("--json")
        if description is not None:
            if len(description) > 1000 or any(ord(character) < 32 for character in description):
                raise ValueError("Description must contain at most 1000 characters without control characters.")
            command.extend(["--description", shlex.quote(description)])
        if metadata_path:
            command.extend(["--metadata-file", f"{remote_dir}/provenance.json"])
        return run(command, check=True, capture_output=True, text=True)
    finally:
        run(
            ["ssh", target, "rm", "-rf", "--", remote_dir],
            check=False,
            capture_output=True,
            text=True,
        )


def main() -> int:
    argv = sys.argv[1:]
    target = os.getenv("TAILPLAN_SSH_TARGET", DEFAULT_TARGET)
    if "--target" in argv:
        index = argv.index("--target")
        if index + 1 >= len(argv):
            print("--target requires an SSH alias", file=sys.stderr)
            return 2
        target = argv[index + 1]
        argv = argv[:index] + argv[index + 2:]
    if argv and argv[0] in {"list", "whoami", "history", "disable", "enable", "delete", "keys"}:
        try:
            validate_target(target)
            return subprocess.run(["ssh", target, "tailplan-share", *map(shlex.quote, argv)], check=False).returncode
        except (ValueError, OSError) as exc:
            print(f"tailplan: {exc}", file=sys.stderr)
            return 2
    if argv and argv[0] == "upload":
        argv = argv[1:]
    parser = argparse.ArgumentParser(
        description="Publish a local Markdown, text, or HTML file through a remote Tailplan server."
    )
    parser.add_argument("file", help="Path to .md, .txt, or .html file")
    parser.add_argument(
        "--target",
        default=target,
        help=f"Configured SSH host alias (default: {DEFAULT_TARGET})",
    )
    version = parser.add_mutually_exclusive_group()
    version.add_argument("--new", action="store_true", help="Create a fresh Tailplan draft")
    version.add_argument("--draft", help="Update a specific Tailplan draft id")
    parser.add_argument("--description")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    try:
        library_path = Path(__file__).resolve().with_name("tailplan-publisher")
        if not library_path.exists():
            library_path = Path(__file__).resolve().with_name("tailplan-share")
        if library_path == Path(__file__).resolve():
            raise RuntimeError("Client helpers are missing. Run install-client.sh again.")
        library = runpy.run_path(str(library_path))
        source = Path(args.file).expanduser().resolve()
        validate_target(args.target)
        mapping_path = Path.home() / ".tailplan" / f"remote-{args.target}-drafts.json"
        with library["source_publish_lock"](mapping_path, source), tempfile.TemporaryDirectory(prefix="tailplan-client-") as temporary:
            mappings = library["load_mappings"](mapping_path)
            selected = library["choose_draft_id"](mappings, source, explicit_draft_id=args.draft, force_new=args.new)
            metadata_path = Path(temporary) / "provenance.json"
            metadata_path.write_text(json.dumps(library["collect_provenance"](source.parent)), encoding="utf-8")
            try:
                result = share_file(source, target=args.target, new=args.new, draft=selected,
                                    description=args.description, json_output=True, metadata_path=metadata_path)
            except subprocess.CalledProcessError as exc:
                try:
                    stale = json.loads(exc.stdout).get("category") == "missing draft"
                except (TypeError, ValueError):
                    stale = False
                if args.draft or not selected or not stale:
                    raise
                result = share_file(source, target=args.target, new=True, draft=None,
                                    description=args.description, json_output=True, metadata_path=metadata_path)
            value = json.loads(result.stdout)
            if not isinstance(value, dict) or value.get("ok") is not True:
                raise RuntimeError("Publisher returned an invalid response.")
            library["update_mapping"](mapping_path, source, value)
            return library["_emit_success"](value, json_output=args.json, stdout=sys.stdout, stderr=sys.stderr)
    except (FileNotFoundError, ValueError, RuntimeError, KeyError) as exc:
        print(f"tailplan-share: {exc}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as exc:
        if exc.stdout:
            print(exc.stdout, end="", file=sys.stdout)
        if exc.stderr:
            print(exc.stderr, end="", file=sys.stderr)
        print(f"tailplan-share: remote publish failed with exit {exc.returncode}", file=sys.stderr)
        return exc.returncode or 1

if __name__ == "__main__":
    raise SystemExit(main())
