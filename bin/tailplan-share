_SCRIPT_PATH = Path(__file__).resolve()


def _share_dir_candidates() -> list[Path]:
    """Return candidate directories that may hold an installed tailplan_ui package."""
    candidates: list[Path] = []
    env_dir = os.getenv("TAILPLAN_SHARE_DIR")
    if env_dir:
        candidates.append(Path(env_dir).expanduser())
    marker = _SCRIPT_PATH.with_name(".tailplan-share-dir")
    try:
        recorded = marker.read_text(encoding="utf-8").strip()
    except OSError:
        recorded = ""
    if recorded:
        candidates.append(Path(recorded).expanduser())
    candidates.append(_SCRIPT_PATH.parents[1])
    candidates.append(Path.home() / ".local" / "share" / "tailplan")
    candidates.append(Path("/usr/local/lib/tailplan"))
    # install.sh puts the server packages in the app directory.
    app_dir = os.getenv("TAILPLAN_APP_DIR")
    if app_dir:
        candidates.append(Path(app_dir).expanduser())
    candidates.append(Path.home() / "apps" / "tailplan")
    candidates.append(Path("/opt/tailplan"))
    return candidates


def _import_tailplan_ui():
    """Return tailplan_ui, appending an installed share directory only if needed."""
    try:
        import tailplan_ui
        return tailplan_ui
    except ImportError:
        pass
    for root in _share_dir_candidates():
        if (root / "tailplan_ui" / "__init__.py").is_file():
            entry = str(root)
            if entry not in sys.path:
                sys.path.append(entry)
            try:
                import tailplan_ui
                return tailplan_ui
            except ImportError:
                continue
    return None


