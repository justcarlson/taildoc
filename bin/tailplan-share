# Tailplan limits blockquote depth to `MAX_QUOTE_DEPTH` to protect the Python recursion limit.
# Tailplan renders additional blockquote markers as escaped text.
MAX_QUOTE_DEPTH = 16


def slug_problem(slug: object) -> str | None:
    """Return why a custom URL slug is invalid, or None when valid."""
    if not isinstance(slug, str) or SLUG_RE.fullmatch(slug) is None:
        return "Custom URLs are 3-40 characters of a-z, 0-9, and inner hyphens."
    if slug[2:4] == "--":
        return "Custom URLs cannot have hyphens as the third and fourth characters."
    if GENERATED_DRAFT_ID_RE.fullmatch(slug) is not None:
        return "Custom URLs cannot be 12 letters and numbers; that is the draft ID format."
    if slug in RESERVED_SLUGS:
        return f'"{slug}" is reserved.'
    return None


def page_path_problem(path: object) -> str | None:
    """Return why a multi-page relative path is invalid, or None when valid."""
    if not isinstance(path, str) or not path:
        return "Page path is missing."
    segments = path.split("/")
    if len(path) > MAX_PAGE_PATH_LENGTH or len(segments) > MAX_PAGE_PATH_SEGMENTS:
        return f'Page path "{path}" is too long.'
    if not path.endswith(".html") or not all(
        PAGE_SEGMENT_RE.fullmatch(segment) for segment in segments
    ):
        return (
            f'Page path "{path}" must be a relative .html path '
            'of letters, numbers, ".", "_", and "-".'
        )
    root = segments[0].removesuffix(".html").lower()
    if root in RESERVED_PAGE_ROOTS or segments[0].lower() in RESERVED_PAGE_ROOTS:
        return f'Page path "{path}" uses the reserved name "{root}".'
    return None


def format_bytes(size: int) -> str:
    if size >= 1024 * 1024:
        return f"{size / (1024 * 1024):.1f}".rstrip("0").rstrip(".") + " MiB"
    if size >= 1024:
        return f"{size / 1024:.1f}".rstrip("0").rstrip(".") + " KiB"
    return f"{size} bytes"


def format_issue(issue: dict) -> str:
    location = f"line {issue['line']}:{issue['column']}" if issue.get("line") else None
    where = " ".join(part for part in (issue.get("path"), location) if part)
    count = f" ({issue['count']} places)" if issue.get("count", 1) > 1 else ""
    fix = f" Fix: {issue['fix']}" if issue.get("fix") else ""
    prefix = f"{where}: " if where else ""
    return f"{prefix}{issue['message']}{count}{fix}"


def shell_quote(value: str) -> str:
    if re.fullmatch(r"[\w@%+=:,./-]+", value):
        return value
    return "'" + value.replace("'", "'\\''") + "'"


def parse_draft_ref(value: str, base_url: str | None = None) -> str:
    """Parse a draft ID, custom slug, or draft URL into its normalized ref."""
    raw = value.strip()
    if "://" in raw:
        try:
            parsed = urllib.parse.urlsplit(raw)
        except ValueError as exc:
            raise ConfigurationFailure(f"Not a valid URL: {raw}") from exc
        match = re.search(r"/d/([^/]+)", parsed.path)
        if not match:
            raise ConfigurationFailure(f"{raw} is not a Tailplan draft URL.")
        ref = match.group(1).lower()
    else:
        ref = raw.lower()
    if DRAFT_REF_RE.fullmatch(ref) is None:
        raise ConfigurationFailure("Draft ID or custom URL is invalid.")
    return ref


def unique_path(target: Path) -> Path:
    """Return target, or the first unused <name>-2<ext> variant."""
    if not target.exists() and not target.is_symlink():
        return target
    stem = target.stem if target.suffix else target.name
    suffix = target.suffix
    number = 2
    while True:
        candidate = target.with_name(f"{stem}-{number}{suffix}")
        if not candidate.exists() and not candidate.is_symlink():
            return candidate
        number += 1


def read_html_folder(directory: Path) -> list[dict]:
    """Read all .html files under a folder as relative POSIX paths."""
    resolved = directory.expanduser().resolve()
    files: list[dict] = []

    def walk(current: Path) -> None:
        for entry in sorted(current.iterdir(), key=lambda item: item.name):
            if entry.name.startswith(".") or entry.name == "node_modules":
                continue
            if entry.is_symlink():
                continue
            if entry.is_dir():
                walk(entry)
            elif entry.is_file() and entry.suffix.lower() == ".html":
                rel = entry.relative_to(resolved).as_posix()
                files.append({"path": rel, "html": entry.read_bytes().decode("utf-8")})

    walk(resolved)
    files.sort(key=lambda item: item["path"])
    return files


def _has_unsafe_scheme_offline(value: str) -> bool:
    decoded = html.unescape(value)
    for _ in range(3):
        expanded = urllib.parse.unquote(decoded)
        if expanded == decoded:
            break
        decoded = expanded
    compact = re.sub(r"[\x00-\x20\x7f]+", "", decoded)
    match = re.match(r"^([a-z][a-z0-9+.-]*):", compact, re.IGNORECASE)
    return bool(match and match.group(1).lower() in BLOCKED_URL_SCHEMES)


def _decode_css_escapes_offline(value: str) -> str:
    decoded: list[str] = []
    index = 0
    while index < len(value):
        if value[index] != "\\":
            decoded.append(value[index])
            index += 1
            continue
        index += 1
        if index == len(value):
            break
        if value[index] in "\n\f":
            index += 1
            continue
        if value[index] == "\r":
            index += 1
            if index < len(value) and value[index] == "\n":
                index += 1
            continue
        start = index
        while index < len(value) and index - start < 6 and value[index] in "0123456789abcdefABCDEF":
            index += 1
        if index > start:
            codepoint = int(value[start:index], 16)
            if index < len(value) and value[index] in " \t\n\r\f":
                index += 1
            if codepoint == 0 or codepoint > 0x10FFFF or 0xD800 <= codepoint <= 0xDFFF:
                decoded.append("\N{REPLACEMENT CHARACTER}")
            else:
                decoded.append(chr(codepoint))
            continue
        decoded.append(value[index])
        index += 1
    return "".join(decoded)


def _css_has_unsafe_url_offline(value: str) -> bool:
    normalized = _decode_css_escapes_offline(value)
    stripped = re.sub(r"/\*.*?\*/", "", normalized, flags=re.DOTALL)
    urls = [m.group(2) for m in CSS_URL_RE.finditer(stripped)]
    urls.extend(m.group(2) for m in CSS_IMPORT_RE.finditer(stripped))
    return bool(re.search(r"expression\s*\(|behavior\s*:", stripped, re.IGNORECASE)) or any(
        _has_unsafe_scheme_offline(url) for url in urls
    )


OPTIONAL_CLOSE_SIBLINGS = {
    "dd": {"dd", "dt"},
    "dt": {"dd", "dt"},
    "li": {"li"},
    "optgroup": {"optgroup", "option"},
    "option": {"option"},
    "p": {"p"},
    "rp": {"rp", "rt"},
    "rt": {"rp", "rt"},
    "tbody": {"tbody", "tfoot", "thead"},
    "td": {"td", "th"},
    "tfoot": {"tbody", "tfoot", "thead"},
    "th": {"td", "th"},
    "thead": {"tbody", "tfoot", "thead"},
    "tr": {"td", "th", "tr"},
}
P_CLOSING_BLOCKS = {
    "address", "article", "aside", "blockquote", "details", "dialog", "dd",
    "div", "dl", "dt", "fieldset", "figcaption", "figure", "footer", "form",
    "h1", "h2", "h3", "h4", "h5", "h6", "header", "hgroup", "hr", "li", "main",
    "nav", "ol", "p", "pre", "section", "table", "ul",
}


class _OfflineHtmlValidator(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._by_key: dict[tuple[str, str, str], dict] = {}
        self._style_depth = 0
        self._tag_stack: list[str] = []
        self.too_deep = False
        self.has_scripts = False
        self.script_sources: list[tuple[str, tuple[int, int]]] = []
        self._active_script: tuple[bool, list[str], tuple[int, int]] | None = None
        self._in_title = False
        self._title_parts: list[str] = []
        self.title: str | None = None

    def _add(self, level: str, code: str, message: str, *, fix: str | None = None, pos: tuple[int, int] | None = None) -> None:
        key = (level, code, message)
        if key in self._by_key:
            self._by_key[key]["count"] += 1
            return
        entry: dict = {"level": level, "code": code, "message": message, "count": 1}
        if fix:
            entry["fix"] = fix
        if pos is not None:
            entry["line"] = pos[0]
            entry["column"] = pos[1] + 1
        self._by_key[key] = entry

    def _push_tag(self, low: str) -> None:
        if low in P_CLOSING_BLOCKS and self._tag_stack and self._tag_stack[-1] == "p":
            self._tag_stack.pop()
        closers = OPTIONAL_CLOSE_SIBLINGS.get(low)
        if closers:
            while self._tag_stack and self._tag_stack[-1] in closers:
                self._tag_stack.pop()
        self._tag_stack.append(low)
        if len(self._tag_stack) > MAX_DEPTH:
            self.too_deep = True

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        low = tag.lower()
        if low not in VOID_ELEMENTS:
            self._push_tag(low)
        self._inspect(low, attrs)

    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        low = tag.lower()
        if low in {"style", "script", "title"}:
            self._push_tag(low)
        elif len(self._tag_stack) + 1 > MAX_DEPTH:
            self.too_deep = True
        self._inspect(low, attrs)

    def handle_endtag(self, tag: str) -> None:
        low = tag.lower()
        if low not in VOID_ELEMENTS and low in self._tag_stack:
            for idx in range(len(self._tag_stack) - 1, -1, -1):
                if self._tag_stack[idx] == low:
                    del self._tag_stack[idx:]
                    break
        if low == "style" and self._style_depth:
            self._style_depth -= 1
        if low == "script" and self._active_script is not None:
            executable, parts, pos = self._active_script
            if executable:
                self.script_sources.append(("".join(parts), pos))
            self._active_script = None
        if low == "title" and self._in_title:
            self._in_title = False
            if self.title is None:
                text = " ".join("".join(self._title_parts).split())[:140]
                if text:
                    self.title = text
            self._title_parts = []

    def handle_data(self, data: str) -> None:
        if self._style_depth and _css_has_unsafe_url_offline(data):
            self._add("error", "unsafe-css", "Blocked unsafe CSS URL found.", pos=self.getpos())
        if self._active_script is not None:
            self._active_script[1].append(data)
        if self._in_title:
            self._title_parts.append(data)

    def _inspect(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        pos = self.getpos()
        attr_values: dict[str, list[str]] = {}
        for name, value in attrs:
            attr_values.setdefault(name.lower(), []).append(value or "")
        if tag == "style":
            self._style_depth += 1
        if tag == "title":
            self._in_title = True
            self._title_parts = []
        if tag in BLOCKED_TAGS_WITH_FIX:
            self._add("error", "blocked-tag", f'Blocked "{tag}" tag.', fix=BLOCKED_TAGS_WITH_FIX[tag], pos=pos)
        if tag == "script":
            if any(name in attr_values for name in ("src", "href", "xlink:href")):
                self._add("error", "external-script", "External script sources are not allowed.",
                          fix="Inline the code in a script block.", pos=pos)
            executable = False
            for raw_type in attr_values.get("type", [""]):
                script_type = raw_type.strip().lower()
                if script_type in EXECUTABLE_SCRIPT_TYPES:
                    executable = True
                    self.has_scripts = True
                elif script_type not in DATA_SCRIPT_TYPES:
                    self._add("error", "script-type", f'Unsupported script type "{script_type}".',
                              fix='Use a classic or type="module" inline script, or type="application/json" for data.', pos=pos)
            self._active_script = (executable, [], pos)
        if tag == "link":
            rels = [t for v in attr_values.get("rel", []) for t in v.lower().split()]
            blocked = next((r for r in rels if r not in ALLOWED_LINK_RELS), None)
            href = (attr_values.get("href", [""])[0]).strip()
            if not rels or blocked is not None:
                self._add("error", "link-rel", f'link rel="{blocked or ""}" is not allowed.',
                          fix="Only stylesheet, icon, and preconnect links are allowed.", pos=pos)
            elif not re.match(r"^https://", href, re.IGNORECASE):
                self._add("error", "link-href", "Linked stylesheets and icons must use https URLs.",
                          fix="Inline the CSS in a style block, or use an https URL.", pos=pos)
        if tag in EMBED_SRC_TAGS:
            refs = [v for a in ("src", "poster") for v in attr_values.get(a, [])]
            for srcset in attr_values.get("srcset", []):
                for cand in re.split(r",\s+", srcset):
                    tok = cand.strip().split()
                    if tok:
                        refs.append(tok[0])
            for ref in refs:
                cleaned = ref.strip()
                low = cleaned.lower()
                if cleaned and not low.startswith("#") and not re.match(r"^(?:https?:|data:|blob:|//)", low) and not _has_unsafe_scheme_offline(cleaned):
                    self._add("warning", "relative-asset", f'"{cleaned}" will not load. Tailplan only hosts HTML pages.',
                              fix="Host the file over https, or inline it as a data: URL.", pos=pos)
        for name, values in attr_values.items():
            if name in EVENT_HANDLER_ATTRS:
                self.has_scripts = True
                for value in values:
                    self.script_sources.append((value, pos))
            if name == "srcdoc":
                self._add("error", "srcdoc", 'Blocked "srcdoc" attribute.', pos=pos)
        if any(len(v) > 1 and n in SECURITY_SENSITIVE_ATTRIBUTES for n, v in attr_values.items()):
            self._add("error", "duplicate-attr", "Blocked duplicate security-sensitive attribute found.", pos=pos)
        if tag == "meta" and any(v.strip().lower() == "refresh" for v in attr_values.get("http-equiv", [])):
            self._add("error", "meta-refresh", "Blocked meta refresh tag found.", fix="Use a normal link.", pos=pos)
        if any(_css_has_unsafe_url_offline(v) for v in attr_values.get("style", [])):
            self._add("error", "unsafe-css", "Blocked unsafe CSS URL found.", pos=pos)
        for name, values in attr_values.items():
            if name in URL_ATTRIBUTES and any(_has_unsafe_scheme_offline(v) for v in values):
                self._add("error", "unsafe-url", f'Blocked unsafe URL in "{name}" attribute.', pos=pos)

    def issues(self) -> list[dict]:
        return list(self._by_key.values())


def validate_upload_offline(pages: list[dict]) -> dict:
    """Validate HTML pages locally when the Tailplan server is unreachable."""
    issues: list[dict] = []
    results: list[dict] = []
    multi_page = len(pages) > 1
    if not pages:
        issues.append({"level": "error", "code": "empty", "message": "Upload has no HTML pages.", "count": 1})
    if len(pages) > MAX_PAGES_PER_UPLOAD:
        issues.append({"level": "error", "code": "too-many-pages",
                       "message": f"Upload has {len(pages)} pages; the limit is {MAX_PAGES_PER_UPLOAD}.", "count": 1})
    seen: set[str] = set()
    seen_lower: set[str] = set()
    dir_prefixes_lower: set[str] = set()
    for page in pages:
        page_path = page.get("path")
        problem = page_path_problem(page_path)
        if problem:
            issues.append({"level": "error", "code": "page-path", "message": problem, "count": 1})
            continue
        lowered = page_path.lower()
        if lowered in seen_lower:
            issues.append({"level": "error", "code": "page-path", "message": f'Page path "{page_path}" appears twice.', "count": 1})
            continue
        seen.add(page_path)
        seen_lower.add(lowered)
        segments = lowered.split("/")
        for idx in range(1, len(segments)):
            dir_prefixes_lower.add("/".join(segments[:idx]))
        doc = page.get("html")
        if not isinstance(doc, str) or not doc.strip():
            entry = {"level": "error", "code": "empty", "message": "HTML document is empty.", "count": 1}
            issues.append({"path": page_path, **entry} if multi_page else entry)
            results.append({"path": page_path, "bytes": 0, "title": None, "hasScripts": False})
            continue
        size = len(doc.encode("utf-8"))
        validator = _OfflineHtmlValidator()
        validator.feed(doc)
        validator.close()
        page_issues = validator.issues()
        if validator.too_deep:
            page_issues.append({"level": "error", "code": "too-deep", "message": f"HTML is nested more than {MAX_DEPTH} levels deep.", "count": 1})
        for code, pattern, message, fix in SANDBOX_APIS:
            matched = next(((t, p) for t, p in validator.script_sources if pattern.search(t)), None)
            if matched is not None:
                page_issues.append({"level": "warning", "code": code, "message": message, "fix": fix,
                                    "line": matched[1][0], "column": matched[1][1] + 1, "count": 1})
        if not TITLE_RE.search(doc):
            page_issues.append({"level": "warning", "code": "no-title", "message": "No <title> found; Tailplan will use a generic title.", "count": 1})
        if not VIEWPORT_RE.search(doc):
            page_issues.append({"level": "warning", "code": "no-viewport",
                                "message": "No viewport meta tag found; phones will show a shrunken desktop page.", "count": 1})
        results.append({"path": page_path, "bytes": size, "title": validator.title, "hasScripts": validator.has_scripts})
        for issue in page_issues:
            issues.append({"path": page_path, **issue} if multi_page else issue)
    for page in results:
        if page["path"].lower() in dir_prefixes_lower:
            issues.append({
                "level": "error",
                "code": "page-path",
                "message": f'Page path "{page["path"]}" conflicts with a folder of the same name.',
                "count": 1,
            })
    if "index.html" not in seen:
        issues.append({"level": "error", "code": "missing-index", "message": "Uploads need an index.html page.", "count": 1})
    total_bytes = sum(p["bytes"] for p in results)
    if total_bytes > MAX_HTML_BYTES:
        issues.append({"level": "error", "code": "too-large",
                       "message": f"HTML is {total_bytes} bytes ({format_bytes(total_bytes)}); maximum is {MAX_HTML_BYTES} bytes ({format_bytes(MAX_HTML_BYTES)}).", "count": 1})
    return {
        "ok": not any(i["level"] == "error" for i in issues),
        "totalBytes": total_bytes,
        "pages": results,
        "issues": issues,
        "errors": [format_issue(i) for i in issues if i["level"] == "error"],
        "warnings": [format_issue(i) for i in issues if i["level"] == "warning"],
    }


def make_links_openable(doc: str) -> str:
    """Rewrite anchor attributes with the same idempotent rules as the server."""
    rewriter = _AnchorRewriter(doc)
    rewriter.feed(doc)
    rewriter.close()
    pieces: list[str] = []
    previous_end = 0
    for start, end, replacement in sorted(rewriter.edits):
        pieces.extend((doc[previous_end:start], replacement))
        previous_end = end
    pieces.append(doc[previous_end:])
    return "".join(pieces)


def _start_tag_attributes(raw: str) -> tuple[list[tuple[str, int, int]], int]:
    spans: list[tuple[str, int, int]] = []
    index = 1
    while index < len(raw) and not raw[index].isspace() and raw[index] not in "/>":
        index += 1
    close_at = len(raw)
    while index < len(raw):
        while index < len(raw) and raw[index].isspace():
            index += 1
        if index >= len(raw):
            break
        if raw[index] == ">":
            close_at = index
            break
        if raw[index] == "/" and index + 1 < len(raw) and raw[index + 1] == ">":
            close_at = index
            break
        start = index
        while (
            index < len(raw)
            and not raw[index].isspace()
            and raw[index] not in "/=>"
        ):
            index += 1
        if index == start:
            index += 1
            continue
        name = raw[start:index].lower()
        while index < len(raw) and raw[index].isspace():
            index += 1
        if index < len(raw) and raw[index] == "=":
            index += 1
            while index < len(raw) and raw[index].isspace():
                index += 1
            if index < len(raw) and raw[index] in {'"', "'"}:
                quote = raw[index]
                index += 1
                while index < len(raw) and raw[index] != quote:
                    index += 1
                if index < len(raw):
                    index += 1
            else:
                while (
                    index < len(raw)
                    and not raw[index].isspace()
                    and raw[index] != ">"
                ):
                    index += 1
        spans.append((name, start, index))
    return spans, close_at


class _AnchorRewriter(HTMLParser):
    def __init__(self, doc: str) -> None:
        super().__init__(convert_charrefs=True)
        self.edits: list[tuple[int, int, str]] = []
        self._line_offsets = [0]
        self._line_offsets.extend(
            index + 1 for index, character in enumerate(doc) if character == "\n"
        )

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag.lower() != "a":
            return
        names = {name.lower() for name, _value in attrs}
        if "href" not in names:
            return
        raw = self.get_starttag_text()
        if raw is None:
            return
        spans, close_at = _start_tag_attributes(raw)
        rel_spans = [(start, end) for name, start, end in spans if name == "rel"]
        changes: list[tuple[int, int, str]] = []
        additions = ""
        if rel_spans:
            changes.append((*rel_spans[0], 'rel="noopener noreferrer"'))
            changes.extend((start, end, "") for start, end in rel_spans[1:])
        else:
            additions += ' rel="noopener noreferrer"'
        if "target" not in names:
            additions = ' target="_blank"' + additions
        if additions:
            changes.append((close_at, close_at, additions))
        parts: list[str] = []
        previous_end = 0
        for start, end, replacement in sorted(changes):
            parts.extend((raw[previous_end:start], replacement))
            previous_end = end
        parts.append(raw[previous_end:])
        replacement = "".join(parts)
        line, column = self.getpos()
        start = self._line_offsets[line - 1] + column
        self.edits.append((start, start + len(raw), replacement))


def _safe_link_destination(destination: str) -> bool:
    if not destination or "\\" in destination or any(
        character.isspace() or ord(character) < 32 or ord(character) == 127
        for character in destination
    ):
        return False
    try:
        parsed = urllib.parse.urlsplit(destination)
        hostname = parsed.hostname
        _ = parsed.port
    except ValueError:
        return False
    return parsed.scheme.lower() in {"http", "https"} and bool(parsed.netloc and hostname)


def _anchor(destination: str, label: str) -> str:
    href = html.escape(destination, quote=True)
    return (
        f'<a href="{href}" target="_blank" rel="noopener noreferrer">{label}</a>'
    )


def _scan_markdown_links(text: str) -> tuple[dict[int, tuple[int, int, int, int, int]], int]:
    """Index complete Markdown links with at most two character visits per input byte."""
    destination_closers: dict[int, int] = {}
    destination_stack: list[int] = []
    character_visits = 0
    for cursor, character in enumerate(text):
        character_visits += 1
        escaped = cursor > 0 and text[cursor - 1] == "\\"
        if character == "(" and not escaped:
            destination_stack.append(cursor)
        elif character == ")" and not escaped and destination_stack:
            destination_closers[destination_stack.pop()] = cursor

    links: dict[int, tuple[int, int, int, int, int]] = {}
    next_label_end: int | None = None
    for cursor in range(len(text) - 1, -1, -1):
        character_visits += 1
        character = text[cursor]
        escaped = cursor > 0 and text[cursor - 1] == "\\"
        if character == "]" and not escaped:
            next_label_end = cursor
        elif character == "[" and next_label_end is not None:
            destination_open = next_label_end + 1
            if destination_open < len(text) and text[destination_open] == "(":
                destination_end = destination_closers.get(destination_open)
                if destination_end is not None:
                    links[cursor] = (
                        destination_end + 1,
                        cursor + 1,
                        next_label_end,
                        destination_open + 1,
                        destination_end,
                    )
    return links, character_visits


def _bare_url_at(text: str, start: int) -> tuple[int, str, str] | None:
    if not (text.startswith("http://", start) or text.startswith("https://", start)):
        return None
    if start and (text[start - 1].isalnum() or text[start - 1] in "_@"):
        return None

    end = start
    while end < len(text) and not text[end].isspace() and text[end] not in '<>"\'`':
        end += 1
    candidate = text[start:end]
    url_end = len(candidate)
    opening_parentheses = candidate.count("(")
    closing_parentheses = candidate.count(")")
    while url_end:
        terminal = candidate[url_end - 1]
        if terminal in ".,;:!?":
            url_end -= 1
        elif terminal == ")" and closing_parentheses > opening_parentheses:
            closing_parentheses -= 1
            url_end -= 1
        else:
            break
    destination = candidate[:url_end]
    if not _safe_link_destination(destination):
        return None
    return end, destination, candidate[url_end:]


def _render_inline(text: str, *, allow_links: bool) -> str:
    rendered: list[str] = []
    markdown_links = _scan_markdown_links(text)[0] if allow_links else {}
    cursor = 0
    while cursor < len(text):
        if text[cursor] == "`":
            run_end = cursor
            while run_end < len(text) and text[run_end] == "`":
                run_end += 1
            delimiter = text[cursor:run_end]
            closer = text.find(delimiter, run_end)
            if closer >= 0:
                rendered.append(f"<code>{html.escape(text[run_end:closer])}</code>")
                cursor = closer + len(delimiter)
                continue

        if text[cursor] == "<":
            tag_end = text.find(">", cursor + 1)
            if tag_end < 0:
                rendered.append(html.escape(text[cursor:]))
                break
            rendered.append(html.escape(text[cursor : tag_end + 1]))
            cursor = tag_end + 1
            continue

        if allow_links and text[cursor] == "[":
            link = markdown_links.get(cursor)
            if link is not None:
                end, label_start, label_end, destination_start, destination_end = link
                label = text[label_start:label_end]
                destination = text[destination_start:destination_end]
                if _safe_link_destination(destination):
                    rendered.append(
                        _anchor(destination, _render_inline(label, allow_links=False))
                    )
                else:
                    rendered.append(html.escape(text[cursor:end]))
                cursor = end
                continue

        if allow_links:
            bare_url = _bare_url_at(text, cursor)
            if bare_url is not None:
                end, destination, suffix = bare_url
                rendered.append(_anchor(destination, html.escape(destination)))
                rendered.append(html.escape(suffix))
                cursor = end
                continue

        if text.startswith("**", cursor):
            closer = text.find("**", cursor + 2)
            if closer > cursor + 2:
                rendered.append(
                    f"<strong>{_render_inline(text[cursor + 2:closer], allow_links=allow_links)}</strong>"
                )
                cursor = closer + 2
                continue

        if text[cursor] == "*" and not text.startswith("**", cursor):
            closer = text.find("*", cursor + 1)
            if closer > cursor + 1:
                rendered.append(
                    f"<em>{_render_inline(text[cursor + 1:closer], allow_links=allow_links)}</em>"
                )
                cursor = closer + 1
                continue

        rendered.append(html.escape(text[cursor]))
        cursor += 1
    return "".join(rendered)


def inline(text: str) -> str:
    """Render a safe, deterministic subset of CommonMark inline syntax."""
    return _render_inline(text, allow_links=True)


def split_table_row(line: str) -> list[str]:
    """Split a GitHub-flavored Markdown table row.

    Supports leading/trailing pipes and escaped literal pipes.
    """
    text = line.strip().removeprefix("|").removesuffix("|")
    cells: list[str] = []
    buf: list[str] = []
    escaped = False
    for ch in text:
        if escaped:
            buf.append(ch)
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == "|":
            cells.append("".join(buf).strip())
            buf = []
        else:
            buf.append(ch)
    if escaped:
        buf.append("\\")
    cells.append("".join(buf).strip())
    return cells


def parse_table_separator(line: str) -> list[str] | None:
    cells = split_table_row(line)
    if not cells:
        return None
    aligns: list[str] = []
    for cell in cells:
        compact = cell.replace(" ", "")
        if not re.fullmatch(r":?-{3,}:?", compact):
            return None
        if compact.startswith(":") and compact.endswith(":"):
            aligns.append("center")
        elif compact.endswith(":"):
            aligns.append("right")
        elif compact.startswith(":"):
            aligns.append("left")
        else:
            aligns.append("")
    return aligns


def render_table(headers: list[str], aligns: list[str], rows: list[list[str]]) -> str:
    col_count = len(headers)

    def cell_attr(index: int) -> str:
        if index < len(aligns) and aligns[index]:
            return f' style="text-align: {aligns[index]}"'
        return ""

    def normalize(row: list[str]) -> list[str]:
        return (row + [""] * col_count)[:col_count]

    head = "".join(
        f"<th{cell_attr(i)}>{inline(value)}</th>" for i, value in enumerate(normalize(headers))
    )
    body_rows = []
    for row in rows:
        cells = "".join(
            f"<td{cell_attr(i)}>{inline(value)}</td>" for i, value in enumerate(normalize(row))
        )
        body_rows.append(f"<tr>{cells}</tr>")
    body = "\n<tbody>\n" + "\n".join(body_rows) + "\n</tbody>" if body_rows else ""
    return f'<div class="table-wrap"><table>\n<thead><tr>{head}</tr></thead>{body}\n</table></div>'


def _line_text(raw_line: str) -> str:
    return raw_line.removesuffix("\n").removesuffix("\r")


def _fence_opening(line: str) -> tuple[str, int, str] | None:
    match = re.fullmatch(r" {0,3}(`{3,}|~{3,})([^\r\n]*)", line)
    if match is None or (match.group(1)[0] == "`" and "`" in match.group(2)):
        return None
    info = match.group(2).strip()
    language = info.split(maxsplit=1)[0] if info else ""
    if language and re.fullmatch(r"[A-Za-z0-9_+-]+", language) is None:
        language = ""
    return match.group(1)[0], len(match.group(1)), language


def _fence_closes(line: str, marker: str, minimum_length: int) -> bool:
    match = re.fullmatch(rf" {{0,3}}({re.escape(marker)}{{{minimum_length},}})[ \t]*", line)
    return match is not None


def _heading(line: str) -> tuple[int, str] | None:
    match = re.fullmatch(r" {0,3}(#{1,6})(?:[ \t]+(.*)|[ \t]*)", line)
    if match is None:
        return None
    content = (match.group(2) or "").strip()
    content = re.sub(r"[ \t]+#+[ \t]*$", "", content)
    return len(match.group(1)), content


def _is_horizontal_rule(line: str) -> bool:
    compact = line.strip().replace(" ", "").replace("\t", "")
    return len(compact) >= 3 and compact[0] in "*_-" and set(compact) == {compact[0]}


def _list_item(line: str) -> tuple[str, str] | None:
    unordered = re.fullmatch(r" {0,3}[-+*][ \t]+(.+)", line)
    if unordered is not None:
        return "ul", unordered.group(1)
    ordered = re.fullmatch(r" {0,3}\d{1,9}[.)][ \t]+(.+)", line)
    if ordered is not None:
        return "ol", ordered.group(1)
    return None


def _is_blockquote(line: str) -> bool:
    return re.match(r"^ {0,3}>", line) is not None


def _starts_table(lines: list[str], index: int) -> tuple[list[str], list[str]] | None:
    if index + 1 >= len(lines) or "|" not in lines[index]:
        return None
    aligns = parse_table_separator(lines[index + 1])
    if aligns is None:
        return None
    headers = split_table_row(lines[index])
    if len(headers) != len(aligns):
        return None
    return headers, aligns


def markdown_to_body(markdown: str, *, _quote_depth: int = 0) -> str:
    """Render a safe block-level subset of GitHub/CommonMark Markdown."""
    raw_lines = markdown.splitlines(keepends=True)
    lines = [_line_text(raw_line) for raw_line in raw_lines]
    out: list[str] = []
    index = 0

    while index < len(lines):
        line = lines[index]
        if not line.strip():
            index += 1
            continue

        fence = _fence_opening(line)
        if fence is not None:
            marker, minimum_length, language = fence
            index += 1
            code_lines: list[str] = []
            while index < len(lines) and not _fence_closes(
                lines[index], marker, minimum_length
            ):
                code_lines.append(raw_lines[index])
                index += 1
            if index < len(lines):
                index += 1
            class_attribute = (
                f' class="language-{html.escape(language, quote=True)}"' if language else ""
            )
            out.append(
                f"<pre><code{class_attribute}>"
                + html.escape("".join(code_lines))
                + "</code></pre>"
            )
            continue

        table = _starts_table(lines, index)
        if table is not None:
            headers, aligns = table
            index += 2
            rows: list[list[str]] = []
            while index < len(lines) and lines[index].strip() and "|" in lines[index]:
                rows.append(split_table_row(lines[index]))
                index += 1
            out.append(render_table(headers, aligns, rows))
            continue

        heading = _heading(line)
        if heading is not None:
            level, content = heading
            out.append(f"<h{level}>{inline(content)}</h{level}>")
            index += 1
            continue

        if _is_horizontal_rule(line):
            out.append("<hr>")
            index += 1
            continue

        item = _list_item(line)
        if item is not None:
            list_type = item[0]
            items: list[str] = []
            while index < len(lines):
                candidate = _list_item(lines[index])
                if candidate is None or candidate[0] != list_type:
                    break
                items.append(candidate[1])
                index += 1
            rendered_items = "\n".join(f"<li>{inline(value)}</li>" for value in items)
            out.append(f"<{list_type}>\n{rendered_items}\n</{list_type}>")
            continue

        if _quote_depth < MAX_QUOTE_DEPTH and _is_blockquote(line):
            quoted: list[str] = []
            while index < len(lines) and _is_blockquote(lines[index]):
                quoted.append(re.sub(r"^ {0,3}>[ \t]?", "", lines[index]))
                index += 1
            quote_body = markdown_to_body("\n".join(quoted), _quote_depth=_quote_depth + 1)
            out.append(f"<blockquote>\n{quote_body}\n</blockquote>")
            continue

        paragraph: list[str] = []
        while index < len(lines):
            candidate = lines[index]
            if not candidate.strip() or paragraph and (
                _fence_opening(candidate) is not None
                or _starts_table(lines, index) is not None
                or _heading(candidate) is not None
                or _is_horizontal_rule(candidate)
                or _list_item(candidate) is not None
                or _is_blockquote(candidate)
            ):
                break
            paragraph.append(candidate.strip())
            index += 1
        out.append(f"<p>{inline(' '.join(paragraph))}</p>")

    return "\n".join(out)


def title_from_content(path: Path, text: str) -> str:
    for line in text.splitlines():
        m = re.match(r"^#\s+(.+)", line.strip())
        if m:
            return m.group(1).strip()[:100]
    return path.stem.replace("-", " ").replace("_", " ").strip().title() or "Tailplan Draft"


def html_document(title: str, body: str, source_name: str) -> str:
    return f"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{html.escape(title)}</title>\n<style>{CSS}</style>\n</head>\n<body>\n<main>\n<div class=\"meta\">Published from {html.escape(source_name)} via Tailplan.</div>\n{body}\n</main>\n</body>\n</html>\n"


def build_html(path: Path, *, home: Path | None = None) -> Path:
    path = path.expanduser().resolve()
    text = path.read_text(encoding="utf-8")
    if path.suffix.lower() in {".html", ".htm"}:
        return path
    out_dir = (home or Path.home()) / ".tailplan" / "generated"
    out_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(out_dir, 0o700)
    safe_stem = re.sub(r"[^A-Za-z0-9_.-]+", "-", path.stem).strip("-") or "draft"
    source_digest = hashlib.sha256(str(path).encode("utf-8")).hexdigest()[:12]
    out = out_dir / f"{safe_stem}-{source_digest}.html"
    out.write_text(html_document(title_from_content(path, text), markdown_to_body(text), path.name), encoding="utf-8")
    os.chmod(out, 0o600)
    return out


def final_html(html_path: Path) -> str:
    """Return the exact document sent and expected on read-back."""
    return html_path.read_bytes().decode("utf-8")


class MappingFailure(RuntimeError):
    def __init__(self, detail: str) -> None:
        self.category = "mapping"
        self.detail = detail
        super().__init__(
            f"Draft mapping error: {detail} Fix or move ~/.tailplan/drafts.json, then retry."
        )


def mapped_draft_id(mappings: dict, source: Path) -> str | None:
    """Return only the valid draft mapped to this resolved source identity."""
    source_key = str(source.expanduser().resolve())
    files = mappings["files"]
    if source_key not in files:
        return None
    entry = files[source_key]
    if not isinstance(entry, dict):
        raise MappingFailure("the selected source entry must be an object.")
    draft_id = entry.get("draftId")
    if not isinstance(draft_id, str) or DRAFT_ID_RE.fullmatch(draft_id) is None:
        raise MappingFailure("the selected source entry has an invalid draftId.")
    if "publicUrl" in entry and not isinstance(entry["publicUrl"], str):
        raise MappingFailure("the selected source entry has an invalid publicUrl.")
    if "versionNumber" in entry and (
        type(entry["versionNumber"]) is not int or entry["versionNumber"] <= 0
    ):
        raise MappingFailure("the selected source entry has an invalid versionNumber.")
    return draft_id


def legacy_generated_path(source: Path, state_home: Path) -> Path | None:
    """Return the pre-source-identity generated path for Markdown/text inputs."""
    if source.suffix.lower() not in {".md", ".txt"}:
        return None
    safe_stem = re.sub(r"[^A-Za-z0-9_.-]+", "-", source.stem).strip("-") or "draft"
    return state_home / ".tailplan" / "generated" / f"{safe_stem}.html"


def legacy_mapped_draft_id(mappings: dict, source: Path, state_home: Path) -> str | None:
    legacy_path = legacy_generated_path(source, state_home)
    if legacy_path is None:
        return None
    return mapped_draft_id(mappings, legacy_path)


def choose_draft_id(
    mappings: dict,
    source: Path,
    *,
    explicit_draft_id: str | None = None,
    force_new: bool = False,
) -> str | None:
    if force_new:
        return None
    return explicit_draft_id or mapped_draft_id(mappings, source)


def load_mappings(mapping_path: Path) -> dict:
    try:
        raw = mapping_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {"files": {}}
    except (OSError, UnicodeError) as error:
        raise MappingFailure("the mapping file could not be read.") from error
    try:
        mappings = json.loads(raw)
    except ValueError as error:
        raise MappingFailure("the mapping file is not valid JSON.") from error
    if not isinstance(mappings, dict):
        raise MappingFailure("the top level must be an object.")
    if "files" not in mappings or not isinstance(mappings["files"], dict):
        raise MappingFailure("the files field must be an object.")
    return mappings


def update_mapping(mapping_path: Path, source: Path, result: dict) -> None:
    """Atomically merge a result under an exclusive cross-process transaction lock."""
    mapping_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = mapping_path.with_name(f".{mapping_path.name}.lock")
    lock_flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_CLOEXEC"):
        lock_flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        lock_flags |= os.O_NOFOLLOW
    lock_fd = os.open(lock_path, lock_flags, 0o600)
    try:
        os.fchmod(lock_fd, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        mappings = load_mappings(mapping_path)
        source_key = str(source.expanduser().resolve())
        existing = mappings["files"].get(source_key)
        if existing is None:
            entry = {}
        elif isinstance(existing, dict):
            entry = dict(existing)
        else:
            raise MappingFailure("the selected source entry must be an object.")
        entry.update(
            {
                "draftId": result["draftId"],
                "publicUrl": result["publicUrl"],
                "versionNumber": result["versionNumber"],
            }
        )
        mappings["files"][source_key] = entry
        data = (json.dumps(mappings, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode(
            "utf-8"
        )
        fd, temporary_name = tempfile.mkstemp(
            prefix=f".{mapping_path.name}.", suffix=".tmp", dir=mapping_path.parent
        )
        temporary = Path(temporary_name)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb") as stream:
                stream.write(data)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, mapping_path)
            directory_fd = os.open(mapping_path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        finally:
            temporary.unlink(missing_ok=True)
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        finally:
            os.close(lock_fd)


def draft_binding_path(state_dir: Path, base_url: str, source: Path) -> Path:
    """Return the per-draft binding path for one API URL and source."""
    key = f"{base_url.rstrip('/')}\n{source.expanduser().resolve()}".encode("utf-8")
    return state_dir / "drafts" / f"{hashlib.sha256(key).hexdigest()}.json"


def read_state_json(path: Path, *, stderr=sys.stderr) -> dict | None:
    """Read a JSON state file, moving corrupt JSON aside for recovery."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError) as exc:
        print(f"Warning: could not read {path}: {exc}", file=stderr)
        return None
    try:
        parsed = json.loads(text)
    except ValueError:
        aside = path.with_name(f"{path.name}.corrupt-{int(time.time() * 1000)}")
        try:
            os.replace(path, aside)
            print(f"Warning: {path} was not valid JSON. Moved it to {aside}.", file=stderr)
        except OSError as exc:
            print(f"Warning: {path} was not valid JSON and could not be moved: {exc}", file=stderr)
        return None
    if not isinstance(parsed, dict):
        aside = path.with_name(f"{path.name}.corrupt-{int(time.time() * 1000)}")
        try:
            os.replace(path, aside)
            print(f"Warning: {path} had invalid state. Moved it to {aside}.", file=stderr)
        except OSError:
            pass
        return None
    return parsed


def _validate_binding_entry(entry: dict) -> str:
    draft_id = entry.get("draftId")
    if not isinstance(draft_id, str) or DRAFT_ID_RE.fullmatch(draft_id) is None:
        raise MappingFailure("the selected source entry has an invalid draftId.")
    if "publicUrl" in entry and not isinstance(entry["publicUrl"], str):
        raise MappingFailure("the selected source entry has an invalid publicUrl.")
    if "versionNumber" in entry and (
        type(entry["versionNumber"]) is not int or entry["versionNumber"] <= 0
    ):
        raise MappingFailure("the selected source entry has an invalid versionNumber.")
    return draft_id


def find_draft_binding(
    state_dir: Path,
    base_url: str,
    source: Path,
    *,
    legacy_mapping_path: Path | None = None,
    stderr=sys.stderr,
) -> dict | None:
    """Find the draft mapped to this source on this API URL."""
    binding_file = draft_binding_path(state_dir, base_url, source)
    binding = read_state_json(binding_file, stderr=stderr)
    if binding is not None:
        try:
            _validate_binding_entry(binding)
            return binding
        except MappingFailure:
            aside = binding_file.with_name(f"{binding_file.name}.corrupt-{int(time.time() * 1000)}")
            try:
                os.replace(binding_file, aside)
                print(f"Warning: {binding_file} had invalid state. Moved it to {aside}.", file=stderr)
            except OSError as exc:
                print(f"Warning: {binding_file} had invalid state and could not be moved: {exc}", file=stderr)
    legacy_path = legacy_mapping_path or (state_dir / "drafts.json")
    if not legacy_path.exists():
        return None
    mappings = load_mappings(legacy_path)
    draft_id = mapped_draft_id(mappings, source)
    if draft_id is None:
        return None
    entry = mappings["files"][str(source.expanduser().resolve())]
    entry_api = entry.get("apiUrl")
    if entry_api and entry_api.rstrip("/") != base_url.rstrip("/"):
        return None
    return entry


def save_draft_binding(state_dir: Path, base_url: str, source: Path, result: dict) -> Path:
    """Atomically write one per-draft binding file under drafts/."""
    target = draft_binding_path(state_dir, base_url, source)
    target.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(target.parent, 0o700)
    entry = {
        "draftId": result["draftId"],
        "publicUrl": result["publicUrl"],
        "versionNumber": result["versionNumber"],
        "apiUrl": base_url.rstrip("/"),
        "file": str(source.expanduser().resolve()),
        "updatedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    if result.get("slug"):
        entry["slug"] = result["slug"]
    data = (json.dumps(entry, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode("utf-8")
    fd, temporary_name = tempfile.mkstemp(
        prefix=f".{target.name}.", suffix=".tmp", dir=target.parent
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
        directory_fd = os.open(target.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)
    return target


def source_publish_lock_path(mapping_path: Path, source: Path) -> Path:
    source_key = str(source.expanduser().resolve()).encode("utf-8")
    digest = hashlib.sha256(source_key).hexdigest()
    return mapping_path.parent / f".source-{digest}.lock"


@contextlib.contextmanager
def source_publish_lock(mapping_path: Path, source: Path):
    """Serialize one source's complete publish transaction across processes."""
    mapping_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = source_publish_lock_path(mapping_path, source)
    lock_flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_CLOEXEC"):
        lock_flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        lock_flags |= os.O_NOFOLLOW
    lock_fd = os.open(lock_path, lock_flags, 0o600)
    try:
        os.fchmod(lock_fd, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        finally:
            os.close(lock_fd)


class ConfigurationFailure(RuntimeError):
    def __init__(self, detail: str) -> None:
        self.category = "configuration"
        self.detail = detail
        super().__init__(detail)


def _validated_http_url(
    value: object,
    *,
    label: str,
    failure_type,
    trim_trailing_slashes: bool = False,
) -> str:
    """Validate and normalize an absolute HTTP(S) URL without leaking parser errors."""

    def fail(detail: str):
        raise failure_type(detail)

    if not isinstance(value, str) or not value.strip():
        fail(f"{label} is missing; provide an http(s) URL.")
    if value != value.strip() or "\\" in value or any(
        character.isspace() or ord(character) < 32 or ord(character) == 127
        for character in value
    ):
        fail(f"{label} must be an unambiguous http(s) URL without whitespace.")
    try:
        parsed = urllib.parse.urlsplit(value)
        hostname = parsed.hostname
        port = parsed.port
        username = parsed.username
        password = parsed.password
    except ValueError as error:
        raise failure_type(f"{label} must be a valid http(s) URL.") from error
    if parsed.scheme not in {"http", "https"} or not parsed.netloc or hostname is None:
        fail(f"{label} must be an http(s) URL.")
    if username is not None or password is not None or "@" in parsed.netloc:
        fail(f"{label} must not contain credentials or userinfo.")
    if parsed.query or parsed.fragment:
        fail(f"{label} must not contain a query or fragment.")
    path = parsed.path.rstrip("/") if trim_trailing_slashes else parsed.path
    segments = path.split("/")[1:] if path else []
    if path.startswith("//") or any(segment in {"", ".", ".."} for segment in segments):
        fail(f"{label} contains an ambiguous path.")
    authority = hostname.lower()
    if ":" in authority:
        authority = f"[{authority}]"
    if port is not None:
        authority += f":{port}"
    return urllib.parse.urlunsplit((parsed.scheme.lower(), authority, path, "", ""))


TAILSCALE_NETWORKS = (
    ipaddress.ip_network("100.64.0.0/10"),
    ipaddress.ip_network("fd7a:115c:a1e0::/48"),
)


def _safe_http_hostname(hostname: str) -> bool:
    if hostname.casefold() == "localhost":
        return True
    try:
        address = ipaddress.ip_address(hostname)
    except ValueError:
        return False
    return address.is_loopback or any(address in network for network in TAILSCALE_NETWORKS)


def validate_base_url(
    base_url: object,
    *,
    allow_insecure_http: bool = False,
) -> str:
    normalized = _validated_http_url(
        base_url,
        label="Base URL",
        failure_type=ConfigurationFailure,
        trim_trailing_slashes=True,
    )
    parsed = urllib.parse.urlsplit(normalized)
    if (
        parsed.scheme == "http"
        and not allow_insecure_http
        and not _safe_http_hostname(parsed.hostname or "")
    ):
        raise ConfigurationFailure(
            "Base URL must use HTTPS for bearer-token uploads. "
            "Use --allow-insecure-http only on a trusted network."
        )
    return normalized


def _loopback_hostname(hostname: str | None) -> bool:
    if hostname is None:
        return False
    if hostname.casefold() == "localhost":
        return True
    try:
        address = ipaddress.ip_address(hostname)
    except ValueError:
        return False
    if isinstance(address, ipaddress.IPv4Address):
        return address.packed[0] == 127
    return address == ipaddress.IPv6Address("::1")


def _equivalent_loopback_public_url(actual: str, expected: str) -> bool:
    actual_url = urllib.parse.urlsplit(actual)
    expected_url = urllib.parse.urlsplit(expected)
    default_port = 443 if actual_url.scheme == "https" else 80
    return (
        actual_url.scheme == expected_url.scheme
        and (actual_url.port or default_port) == (expected_url.port or default_port)
        and actual_url.path == expected_url.path
        and _loopback_hostname(actual_url.hostname)
        and _loopback_hostname(expected_url.hostname)
    )


def default_base_url() -> str:
    env_path = Path.home() / ".tailplan" / "env"
    try:
        env_text = env_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        env_text = ""
    except (OSError, UnicodeError) as error:
        raise ConfigurationFailure(
            "Tailplan configuration could not be read; check ~/.tailplan/env permissions and UTF-8."
        ) from error
    for line in env_text.splitlines():
        if line.startswith("TAILPLAN_BASE_URL="):
            return line.split("=", 1)[1].strip().strip('"')
    try:
        ip = subprocess.check_output(
            ["tailscale", "ip", "-4"], text=True, stderr=subprocess.DEVNULL
        ).strip().splitlines()[0]
        return f"http://{ip}:9127"
    except (OSError, subprocess.SubprocessError, UnicodeError, IndexError):
        return "http://127.0.0.1:9127"


class ProtocolFailure(RuntimeError):
    def __init__(self, detail: str = "server returned an invalid success response") -> None:
        self.category = "protocol"
        self.detail = detail
        super().__init__(f"Upload failed (protocol): {detail}")


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _open_without_redirects(request: urllib.request.Request, *, timeout: float):
    return urllib.request.build_opener(_NoRedirectHandler()).open(request, timeout=timeout)


def validate_upload_result(
    result: object,
    base_url: object,
    *,
    allow_insecure_http: bool = False,
) -> dict:
    if not isinstance(result, dict) or result.get("ok") is not True:
        raise ProtocolFailure()
    draft_id = result.get("draftId")
    if not isinstance(draft_id, str) or DRAFT_ID_RE.fullmatch(draft_id) is None:
        raise ProtocolFailure()
    slug = result.get("slug")
    if slug is not None and (not isinstance(slug, str) or slug_problem(slug) is not None):
        raise ProtocolFailure("server returned an invalid slug")
    public_url = result.get("publicUrl")
    normalized_public_url = _validated_http_url(
        public_url,
        label="Public URL",
        failure_type=ProtocolFailure,
    )
    normalized_base = validate_base_url(base_url, allow_insecure_http=allow_insecure_http)
    expected_urls = [f"{normalized_base}/d/{draft_id}"]
    if slug:
        expected_urls.append(f"{normalized_base}/d/{slug}")
    if not any(
        normalized_public_url == candidate
        or _equivalent_loopback_public_url(normalized_public_url, candidate)
        for candidate in expected_urls
    ):
        raise ProtocolFailure()
    if "shareUrl" in result and result["shareUrl"] != public_url.rstrip("/") + "/share":
        raise ProtocolFailure("server returned an invalid share URL")
    version_number = result.get("versionNumber")
    if type(version_number) is not int or version_number <= 0:
        raise ProtocolFailure()
    warnings = result.get("warnings", [])
    if not isinstance(warnings, list) or any(not isinstance(item, str) for item in warnings):
        raise ProtocolFailure()
    return result


class UploadFailure(RuntimeError):
    def __init__(self, category: str, detail: str, *, status: int | None = None) -> None:
        self.category = category
        self.detail = detail
        self.status = status
        prefix = f"Upload failed ({category})"
        super().__init__(f"{prefix}: {detail}")


def _http_failure(status: int, detail: str) -> UploadFailure:
    if status in {401, 403}:
        category = "authentication"
    elif status == 413:
        category = "size"
    elif status == 404:
        category = "missing draft"
    elif status == 409:
        category = "conflict"
    elif status in {400, 411, 422}:
        category = "validation"
    elif status >= 500:
        category = "server unavailable"
    else:
        category = "request rejected"
    return UploadFailure(category, detail, status=status)


def _safe_server_detail(value: str, *, sensitive: tuple[str, ...]) -> str:
    normalized = " ".join(value.split())
    if "<" in normalized or ">" in normalized:
        return "[redacted unsafe content]"
    for secret in sensitive:
        if secret and secret in normalized:
            normalized = normalized.replace(secret, "[redacted]")
    if len(normalized) > 160:
        normalized = normalized[:157] + "..."
    return normalized


def _error_detail(
    error: urllib.error.HTTPError, *, sensitive: tuple[str, ...] = ()
) -> str:
    try:
        decoded = json.loads(error.read().decode("utf-8", "replace"))
    except (ValueError, OSError, http.client.HTTPException):
        return f"HTTP {error.code}"
    if not isinstance(decoded, dict):
        return f"HTTP {error.code}"
    errors = decoded.get("errors")
    if isinstance(errors, list):
        safe_errors = [
            _safe_server_detail(item, sensitive=sensitive)
            for item in errors[:3]
            if isinstance(item, str) and item.strip()
        ]
        if safe_errors:
            return "; ".join(safe_errors)
    detail = decoded.get("error")
    if isinstance(detail, str) and detail.strip():
        return _safe_server_detail(detail, sensitive=sensitive)
    return f"HTTP {error.code}"


def upload(
    html_path: Path,
    base_url: str,
    draft_id: str | None,
    *,
    token_path: Path | None = None,
    opener=None,
    sleeper=time.sleep,
    idempotency_key: str | None = None,
    max_attempts: int = 3,
    timeout: float = 20,
    html_doc: str | None = None,
    allow_insecure_http: bool = False,
    description: str | None = None,
    metadata: dict | None = None,
    content_request: dict | None = None,
    files: list[dict] | None = None,
    slug: str | None = None,
) -> dict:
    token_file = token_path or Path(os.getenv("TAILPLAN_TOKEN_FILE", str(Path.home() / ".tailplan" / "token")))
    try:
        token = os.getenv("TAILPLAN_API_KEY") or token_file.read_text(encoding="utf-8").strip()
    except FileNotFoundError as error:
        raise ConfigurationFailure(
            "Tailplan token is missing; create ~/.tailplan/token, then retry."
        ) from error
    except (OSError, UnicodeError) as error:
        raise ConfigurationFailure(
            "Tailplan token could not be read; check its permissions and UTF-8 encoding."
        ) from error
    if not token:
        raise ConfigurationFailure("Tailplan token is empty; replace ~/.tailplan/token, then retry.")
    upload_base_url = validate_base_url(
        base_url,
        allow_insecure_http=allow_insecure_http,
    )
    payload: dict = {
        "filename": html_path.name,
        "draftId": draft_id,
    }
    if files is not None:
        payload["files"] = files
    elif content_request is not None:
        payload.update(content_request)
    else:
        payload["html"] = final_html(html_path) if html_doc is None else html_doc
    if slug is not None:
        payload["slug"] = slug
    if description is not None:
        payload["description"] = description
    if metadata is not None:
        payload["metadata"] = metadata
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    request_key = idempotency_key or secrets.token_urlsafe(32)
    attempts = max(1, max_attempts)
    open_request = opener or _open_without_redirects
    for attempt in range(1, attempts + 1):
        retry_delay = 0.25 * (2 ** (attempt - 1))
        request = urllib.request.Request(
            upload_base_url + "/api/uploads",
            data=body,
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {token}",
                "Idempotency-Key": request_key,
                "User-Agent": "tailplan-share/2.0",
            },
        )
        try:
            with open_request(request, timeout=timeout) as response:
                status = getattr(response, "status", None)
                if isinstance(status, int) and 300 <= status < 400:
                    raise ProtocolFailure(
                        f"upload endpoint returned HTTP {status}; redirects are not allowed"
                    )
                result = json.loads(response.read().decode("utf-8"))
                if not isinstance(result, dict):
                    raise TypeError("response is not an object")
                return result
        except urllib.error.HTTPError as error:
            if 300 <= error.code < 400:
                raise ProtocolFailure(
                    f"upload endpoint returned HTTP {error.code}; redirects are not allowed"
                ) from None
            detail = _error_detail(error, sensitive=(token,))
            failure = _http_failure(error.code, detail)
            retryable = error.code == 429 or error.code >= 500
            if not retryable or attempt == attempts:
                raise failure from None
            retry_after = _header_value(error.headers, "Retry-After")
            if (
                error.code == 429
                and isinstance(retry_after, str)
                and re.fullmatch(r"[0-9]+", retry_after) is not None
                and int(retry_after) <= 60
            ):
                retry_delay = int(retry_after)
        except (
            urllib.error.URLError,
            TimeoutError,
            ConnectionError,
            OSError,
            http.client.HTTPException,
        ) as error:
            if attempt == attempts:
                raise UploadFailure(
                    "server unavailable", "network request failed after bounded retries"
                ) from error
        except (UnicodeDecodeError, TypeError, ValueError) as error:
            raise UploadFailure("server unavailable", "server returned an invalid response") from error
        sleeper(retry_delay)

    raise AssertionError("unreachable")


class VerificationFailure(RuntimeError):
    pass


def _header_value(headers, name: str) -> str | None:
    value = headers.get(name)
    if value is not None:
        return value
    target = name.lower()
    for key, candidate in headers.items():
        if key.lower() == target:
            return candidate
    return None


def verify_readback(
    public_url: str,
    expected_html: str | None,
    *,
    expected_sha256: str | None = None,
    opener=None,
    timeout: float = 20,
) -> None:
    verification_url = (
        public_url
        + ("&" if "?" in public_url else "?")
        + "verify="
        + secrets.token_urlsafe(12)
    )
    request = urllib.request.Request(
        verification_url,
        method="GET",
        headers={"User-Agent": "tailplan-share/2.0", "Accept": "text/html"},
    )
    open_request = opener or _open_without_redirects
    try:
        with open_request(request, timeout=timeout) as response:
            status = getattr(response, "status", None)
            if status != 200:
                raise VerificationFailure(f"read-back returned HTTP {status}, expected 200")
            content_type = _header_value(response.headers, "Content-Type")
            if content_type is None or content_type.split(";", 1)[0].strip().lower() != "text/html":
                raise VerificationFailure("read-back Content-Type is not text/html")
            expected_headers = {
                "Cache-Control": "no-store",
                "X-Content-Type-Options": "nosniff",
                "Referrer-Policy": "no-referrer",
                "X-Frame-Options": "DENY",
            }
            for name, expected in expected_headers.items():
                actual = _header_value(response.headers, name)
                if actual != expected:
                    raise VerificationFailure(
                        f"read-back security header {name} was {actual!r}, expected {expected!r}"
                    )
            csp = _header_value(response.headers, "Content-Security-Policy")
            if csp is None:
                raise VerificationFailure("read-back Content-Security-Policy is missing")
            directives: dict[str, list[str]] = {}
            for raw_directive in csp.split(";"):
                parts = raw_directive.strip().split()
                if not parts:
                    continue
                if parts[0] in directives:
                    raise VerificationFailure(
                        f"read-back Content-Security-Policy repeats {parts[0]}"
                    )
                directives[parts[0]] = parts[1:]
            for name in ("default-src", "form-action", "frame-ancestors"):
                if directives.get(name) != ["'none'"]:
                    raise VerificationFailure(
                        "read-back Content-Security-Policy requires " f"{name} 'none'"
                    )
            script_src = directives.get("script-src")
            if script_src != ["'none'"]:
                sandbox = directives.get("sandbox") or []
                valid_sandbox = (
                    script_src == ["'unsafe-inline'"]
                    and "allow-scripts" in sandbox
                    and "allow-same-origin" not in sandbox
                )
                if not valid_sandbox:
                    raise VerificationFailure(
                        "read-back Content-Security-Policy requires script-src 'none' or a sandboxed inline script policy"
                    )
            actual_bytes = response.read()
    except VerificationFailure:
        raise
    except urllib.error.HTTPError as error:
        if 300 <= error.code < 400:
            raise VerificationFailure(
                f"read-back returned HTTP {error.code}; redirects are not allowed"
            ) from None
        raise VerificationFailure(f"read-back unavailable (HTTP {error.code}); retry publish") from None
    except (
        urllib.error.URLError,
        TimeoutError,
        ConnectionError,
        OSError,
        http.client.HTTPException,
    ) as error:
        raise VerificationFailure("read-back unavailable; check Tailplan connectivity and retry") from error

    if expected_sha256 is not None:
        if not re.fullmatch(r"[0-9a-f]{64}", expected_sha256) or hashlib.sha256(actual_bytes).hexdigest() != expected_sha256:
            raise VerificationFailure("read-back content digest mismatch")
        return
    if expected_html is None:
        raise VerificationFailure("Missing expected HTML or checksum")
    expected_bytes = expected_html.encode("utf-8")
    try:
        actual_html = actual_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise VerificationFailure("read-back is not valid UTF-8") from error
    expected_title = TITLE_RE.search(expected_html)
    if expected_title is not None and expected_title.group(0) not in actual_html:
        raise VerificationFailure("read-back title differs from uploaded document")
    if actual_bytes != expected_bytes:
        expected_digest = hashlib.sha256(expected_bytes).hexdigest()[:12]
        actual_digest = hashlib.sha256(actual_bytes).hexdigest()[:12]
        raise VerificationFailure(
            "read-back content digest mismatch "
            f"(expected {expected_digest}, got {actual_digest}); retry publish"
        )


def _emit_failure(
    category: str,
    error: str,
    *,
    json_output: bool,
    stdout,
    stderr,
    exit_code: int = 1,
) -> int:
    if json_output:
        print(
            json.dumps(
                {"ok": False, "category": category, "error": error},
                ensure_ascii=False,
                separators=(",", ":"),
            ),
            file=stdout,
        )
    else:
        print(error, file=stderr)
    return exit_code


def _emit_success(result: dict, *, json_output: bool, stdout, stderr) -> int:
    warnings = result.get("warnings") or []
    if json_output:
        print(
            json.dumps(
                {
                    "ok": True,
                    "draftId": result["draftId"],
                    "publicUrl": result["publicUrl"],
                    "versionNumber": result["versionNumber"],
                    "warnings": warnings,
                    **{
                        key: result[key]
                        for key in (
                            "rawUrl", "shareUrl", "versionUrl", "versionId",
                            "fileSha256", "contentHash", "totalBytes", "requestId",
                            "theme", "slug", "unchanged", "pages",
                        )
                        if key in result
                    },
                },
                ensure_ascii=False,
                separators=(",", ":"),
            ),
            file=stdout,
        )
        return 0
    if result.get("unchanged"):
        print(f"Unchanged: this content is already version {result['versionNumber']}", file=stdout)
    else:
        print("Uploaded draft" if result["versionNumber"] == 1 else "Updated draft", file=stdout)
    print(f"URL: {result.get('shareUrl') or result['publicUrl']}", file=stdout)
    if result.get("rawUrl"):
        print(f"Raw HTML: {result['rawUrl']}", file=stdout)
    if result.get("versionUrl"):
        print(f"Version URL: {result['versionUrl']}", file=stdout)
    print(f"Draft ID: {result['draftId']}", file=stdout)
    if result.get("slug"):
        print(f"Slug: {result['slug']}", file=stdout)
    print(f"Version: {result['versionNumber']}", file=stdout)
    if result.get("pages"):
        print("Pages: " + ", ".join(page["path"] for page in result["pages"]), file=stdout)
    for warning in warnings:
        print(f"Warning: {warning}", file=stderr)
    return 0


def _publish_locked(
    source: Path,
    base_url: str,
    *,
    explicit_draft_id: str | None = None,
    force_new: bool = False,
    home: Path | None = None,
    uploader=None,
    verifier=None,
    stdout=sys.stdout,
    stderr=sys.stderr,
    json_output: bool = False,
    allow_insecure_http: bool = False,
    description: str | None = None,
    metadata: dict | None = None,
    theme: str | None = None,
    document_type: str | None = None,
    layout: str | None = None,
    typography: str | None = None,
    slug: str | None = None,
    files: list[dict] | None = None,
) -> int:
    resolved_source = source.expanduser().resolve()
    state_home = home or Path.home()
    state_dir = state_home / ".tailplan"
    is_folder = files is not None or resolved_source.is_dir()
    is_html = is_folder or resolved_source.suffix.lower() in {".html", ".htm"}
    if is_html and any(value is not None for value in (theme, document_type, layout, typography)):
        return _emit_failure("theme", "Theme options require Markdown or text input.",
                             json_output=json_output, stdout=stdout, stderr=stderr)
    upload_files = files
    if upload_files is None and resolved_source.is_dir():
        try:
            upload_files = read_html_folder(resolved_source)
        except (OSError, UnicodeError):
            return _emit_failure("file", "Cannot read UTF-8 HTML files in folder.",
                                 json_output=json_output, stdout=stdout, stderr=stderr)
        if not upload_files:
            return _emit_failure("file", f"No .html files found in {resolved_source}",
                                 json_output=json_output, stdout=stdout, stderr=stderr)
    content_request = None
    if not is_html and uploader is None:
        try:
            content_request = {"content": resolved_source.read_text(encoding="utf-8"),
                               "filename": resolved_source.name,
                               "format": "text" if resolved_source.suffix.lower() == ".txt" else "markdown",
                               "theme": theme or "auto", "documentType": document_type or "document",
                               "layout": layout or "reading"}
            if typography is not None:
                content_request["typography"] = typography
        except (OSError, UnicodeError):
            return _emit_failure("file", "Cannot read UTF-8 input.", json_output=json_output,
                                 stdout=stdout, stderr=stderr)
    if upload_files is not None:
        html_path = resolved_source
    else:
        try:
            html_path = build_html(resolved_source, home=state_home)
        except UnicodeError:
            return _emit_failure(
                "file",
                "Input file is not valid UTF-8; convert it to UTF-8, then retry.",
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )
        except OSError:
            return _emit_failure(
                "file",
                "Could not read the input or write generated HTML; check file permissions, then retry.",
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )

    mapping_path = state_dir / "drafts.json"
    try:
        binding = find_draft_binding(
            state_dir,
            base_url,
            resolved_source,
            legacy_mapping_path=mapping_path,
            stderr=stderr,
        )
        mapped_id = binding["draftId"] if binding is not None else None
        if (
            explicit_draft_id is None
            and not force_new
            and slug is None
            and mapped_id is None
            and not is_folder
            and mapping_path.exists()
        ):
            mappings = load_mappings(mapping_path)
            legacy_id = legacy_mapped_draft_id(mappings, resolved_source, state_home)
            if legacy_id is not None:
                raise MappingFailure(
                    f"legacy draft {legacy_id} may belong to this source; "
                    f"rerun once with --draft {legacy_id} to preserve continuity."
                )
        if force_new:
            draft_id = None
        elif explicit_draft_id is not None:
            draft_id = explicit_draft_id
        elif slug is not None:
            draft_id = None
        else:
            draft_id = mapped_id
    except MappingFailure as error:
        return _emit_failure(
            error.category,
            str(error),
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )

    verify_function = verifier or verify_readback
    if upload_files is not None:
        index_entry = next((p for p in upload_files if p.get("path") == "index.html"), None)
        expected = index_entry["html"] if index_entry else ""
    else:
        try:
            expected = final_html(html_path)
        except UnicodeError:
            return _emit_failure(
                "file",
                "Input file is not valid UTF-8; convert it to UTF-8, then retry.",
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )
        except OSError:
            return _emit_failure(
                "file",
                "Could not read the input; check file permissions, then retry.",
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )

    def upload_once(selected_draft_id: str | None):
        if uploader is None:
            provenance_cwd = resolved_source if resolved_source.is_dir() else resolved_source.parent
            return upload(
                html_path,
                base_url,
                selected_draft_id,
                html_doc=expected if upload_files is None else None,
                **({"files": upload_files} if upload_files is not None else {}),
                **({"slug": slug} if slug is not None else {}),
                **({"content_request": content_request} if content_request is not None else {}),
                allow_insecure_http=allow_insecure_http,
                description=description,
                metadata=metadata if metadata is not None else collect_provenance(provenance_cwd),
            )
        return uploader(html_path, base_url, selected_draft_id)

    try:
        result = upload_once(draft_id)
    except UploadFailure as error:
        stale_implicit_mapping = (
            explicit_draft_id is None
            and not force_new
            and slug is None
            and draft_id is not None
            and error.status == 404
            and error.category == "missing draft"
        )
        if not stale_implicit_mapping:
            return _emit_failure(
                error.category,
                str(error),
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )
        try:
            result = upload_once(None)
        except (UploadFailure, ConfigurationFailure, ProtocolFailure) as fallback_error:
            return _emit_failure(
                fallback_error.category,
                str(fallback_error),
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )
        except OSError:
            return _emit_failure(
                "file",
                "Could not read the input or complete the upload; check permissions and retry.",
                json_output=json_output,
                stdout=stdout,
                stderr=stderr,
            )
    except (ConfigurationFailure, ProtocolFailure) as error:
        return _emit_failure(
            error.category,
            str(error),
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )
    except OSError:
        return _emit_failure(
            "file",
            "Could not read the input or complete the upload; check permissions and retry.",
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )

    try:
        result = validate_upload_result(
            result,
            base_url,
            allow_insecure_http=allow_insecure_http,
        )
    except ProtocolFailure as error:
        return _emit_failure(
            error.category,
            str(error),
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )

    try:
        save_draft_binding(state_dir, base_url, resolved_source, result)
    except (MappingFailure, OSError):
        return _emit_failure(
            "mapping",
            "Could not save the local draft mapping after upload; fix disk/permissions, then "
            f"rerun with --draft {result['draftId']} to avoid creating a duplicate.",
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )
    try:
        if content_request is not None and verifier is None:
            digest = result.get("fileSha256")
            if not isinstance(digest, str):
                raise VerificationFailure("Server omitted rendered content checksum")
            verify_readback(result["publicUrl"] + f"/v/{result['versionNumber']}/content", None,
                            expected_sha256=digest)
        else:
            verify_url = result["publicUrl"]
            if result.get("pages"):
                verify_url = verify_url.rstrip("/") + "/"
            verify_function(verify_url, expected)
    except VerificationFailure as error:
        return _emit_failure(
            "verification",
            f"Verification failed: {error}",
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )

    return _emit_success(result, json_output=json_output, stdout=stdout, stderr=stderr)


def publish(
    source: Path,
    base_url: str,
    *,
    explicit_draft_id: str | None = None,
    force_new: bool = False,
    home: Path | None = None,
    uploader=None,
    verifier=None,
    stdout=sys.stdout,
    stderr=sys.stderr,
    json_output: bool = False,
    allow_insecure_http: bool = False,
    description: str | None = None,
    metadata: dict | None = None,
    theme: str | None = None,
    document_type: str | None = None,
    layout: str | None = None,
    typography: str | None = None,
    slug: str | None = None,
    files: list[dict] | None = None,
) -> int:
    resolved_source = source.expanduser().resolve()
    state_home = home or Path.home()
    mapping_path = state_home / ".tailplan" / "drafts.json"
    try:
        with source_publish_lock(mapping_path, resolved_source):
            return _publish_locked(
                resolved_source,
                base_url,
                explicit_draft_id=explicit_draft_id,
                force_new=force_new,
                home=state_home,
                uploader=uploader,
                verifier=verifier,
                stdout=stdout,
                stderr=stderr,
                json_output=json_output,
                allow_insecure_http=allow_insecure_http,
                description=description,
                metadata=metadata,
                theme=theme,
                document_type=document_type,
                layout=layout,
                typography=typography,
                slug=slug,
                files=files,
            )
    except OSError:
        return _emit_failure(
            "mapping",
            "Could not acquire the local source publish lock; check ~/.tailplan permissions, "
            "then retry.",
            json_output=json_output,
            stdout=stdout,
            stderr=stderr,
        )


class CliUsageFailure(RuntimeError):
    pass


class TailplanArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise CliUsageFailure(message)


def _load_files_json(path: Path) -> list[dict]:
    data = json.loads(path.read_text(encoding="utf-8"))
    files = data.get("files") if isinstance(data, dict) else data
    if not isinstance(files, list) or not files:
        raise ValueError("Files JSON must contain a non-empty files list.")
    for item in files:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not isinstance(item.get("html"), str):
            raise ValueError("Each page entry must have string path and html fields.")
    return files


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    if raw_argv and raw_argv[0] in {
        "auth", "whoami", "list", "history", "keys", "disable", "enable", "delete",
        "themes", "typography", "check", "favorite", "unfavorite", "download",
    }:
        return management_main(raw_argv)
    if raw_argv and raw_argv[0] == "upload":
        raw_argv.pop(0)
    json_output = "--json" in raw_argv
    parser = TailplanArgumentParser(
        description="Share a markdown/text/html artifact or HTML folder through Tailplan.",
        epilog=(
            "Commands: upload, check, download, favorite, unfavorite, list, "
            "history, whoami, auth, keys, disable, enable, delete. Use COMMAND --help."
        ),
    )
    parser.add_argument("--version", action="version", version="tailplan 0.3.0")
    parser.add_argument("file", nargs="?", help="Path to .md, .txt, .html, .htm file, or HTML folder")
    parser.add_argument("--files-json", dest="files_json", help="Read multi-page files array from a JSON file")
    parser.add_argument("--base-url", "--api-url", dest="base_url")
    parser.add_argument("--slug", help="Set or update a custom URL slug")
    parser.add_argument("--description", help="Set a stable draft description")
    parser.add_argument("--theme", help="Theme ID or auto; list with tailplan themes")
    parser.add_argument("--document-type", help="Deterministic selection hint, such as plan or technical")
    parser.add_argument("--typography", help="Font preset ID; list with tailplan typography")
    parser.add_argument("--layout", help="Document layout: reading or brief")
    parser.add_argument("--metadata-file", help="Read source provenance from a JSON file")
    parser.add_argument("--json", action="store_true", help="Emit one machine-readable JSON object")
    parser.add_argument(
        "--allow-insecure-http",
        action="store_true",
        help="Allow bearer-token uploads to an HTTP host outside safe local and Tailscale ranges",
    )
    draft_mode = parser.add_mutually_exclusive_group()
    draft_mode.add_argument("--draft", help="Update exactly this draft id")
    draft_mode.add_argument("--new", action="store_true", help="Create a fresh draft")
    try:
        args = parser.parse_args(raw_argv)
    except CliUsageFailure as error:
        return _emit_failure(
            "usage",
            f"Invalid arguments: {error}",
            json_output=json_output,
            stdout=sys.stdout,
            stderr=sys.stderr,
            exit_code=2,
        )

    if args.new and args.slug is not None:
        return _emit_failure(
            "usage",
            "Invalid arguments: --new cannot be combined with --slug.",
            json_output=args.json,
            stdout=sys.stdout,
            stderr=sys.stderr,
            exit_code=2,
        )
    if args.slug is not None:
        normalized_slug = args.slug.strip().lower()
        problem = slug_problem(normalized_slug)
        if problem is not None:
            return _emit_failure(
                "usage",
                f"Invalid slug: {problem}",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )
        args.slug = normalized_slug

    upload_files = None
    if args.files_json:
        if args.file is not None:
            return _emit_failure(
                "usage",
                "Invalid arguments: provide either a file path or --files-json, not both.",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )
        try:
            source = Path(args.files_json).expanduser().resolve()
            upload_files = _load_files_json(source)
        except (OSError, ValueError, TypeError, UnicodeError) as error:
            return _emit_failure(
                "file",
                f"Could not read multi-page JSON: {error}",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )
    else:
        if args.file is None:
            return _emit_failure(
                "usage",
                "Invalid arguments: the following arguments are required: file",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )
        try:
            source = Path(args.file).expanduser().resolve()
        except OSError:
            return _emit_failure(
                "file",
                "Input path could not be resolved; check the path and retry.",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )
        if not source.exists() or (not source.is_file() and not source.is_dir()):
            return _emit_failure(
                "file",
                f"File does not exist or is not a regular file: {source}",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )
        if source.is_file() and source.suffix.lower() not in {".md", ".txt", ".html", ".htm"}:
            return _emit_failure(
                "file",
                "Unsupported file type; use .md, .txt, .html, or .htm.",
                json_output=args.json,
                stdout=sys.stdout,
                stderr=sys.stderr,
                exit_code=2,
            )

    try:
        configured_base_url = (
            args.base_url
            if args.base_url is not None
            else (os.getenv("TAILPLAN_BASE_URL") or default_base_url())
        )
        base_url = validate_base_url(
            configured_base_url,
            allow_insecure_http=args.allow_insecure_http,
        )
    except ConfigurationFailure as error:
        return _emit_failure(
            error.category,
            str(error),
            json_output=args.json,
            stdout=sys.stdout,
            stderr=sys.stderr,
            exit_code=2,
        )

    metadata = None
    if args.metadata_file:
        try:
            metadata = json.loads(Path(args.metadata_file).read_text(encoding="utf-8"))
            if not isinstance(metadata, dict):
                raise TypeError("metadata must be an object")
        except (OSError, ValueError, TypeError, UnicodeError):
            return _emit_failure("file", "Metadata file must contain a JSON object.",
                                 json_output=args.json, stdout=sys.stdout, stderr=sys.stderr, exit_code=2)
    return publish(
        source,
        base_url,
        explicit_draft_id=args.draft,
        force_new=args.new,
        stdout=sys.stdout,
        stderr=sys.stderr,
        json_output=args.json,
        allow_insecure_http=args.allow_insecure_http,
        description=args.description,
        metadata=metadata,
        theme=args.theme,
        document_type=args.document_type,
        layout=args.layout,
        typography=args.typography,
        slug=args.slug,
        files=upload_files,
    )


def collect_provenance(cwd: Path) -> dict:
    def git(*args):
        try:
            return subprocess.check_output(["git", *args], cwd=cwd, text=True,
                                           stderr=subprocess.DEVNULL, timeout=5).strip()
        except (OSError, subprocess.SubprocessError, UnicodeError):
            return None

    metadata = {"cliVersion": "0.3.0"}
    root = git("rev-parse", "--show-toplevel")
    if root:
        remote = git("config", "--get", "remote.origin.url") or ""
        scp = re.fullmatch(r"[^@\s]+@([^:/\s]+):(.+)", remote)
        try:
            parsed = urllib.parse.urlparse("ssh://" + scp[1] + "/" + scp[2] if scp else remote)
            parts = parsed.path.removesuffix(".git").strip("/").split("/")
            metadata.update(repoHost=parsed.hostname, repoOrg=parts[0] if len(parts) > 1 else None,
                            repoName=parts[-1] if parsed.hostname else Path(root).name)
        except ValueError:
            metadata["repoName"] = Path(root).name
        status = git("status", "--porcelain")
        metadata.update(gitBranch=git("rev-parse", "--abbrev-ref", "HEAD"),
                        gitCommitSha=git("rev-parse", "HEAD"),
                        gitCommitSubject=git("log", "-1", "--format=%s"),
                        gitDirty=bool(status) if status is not None else None)
    if os.getenv("GITHUB_ACTIONS") == "true":
        repo, run = os.getenv("GITHUB_REPOSITORY"), os.getenv("GITHUB_RUN_ID")
        server = os.getenv("GITHUB_SERVER_URL", "https://github.com").rstrip("/")
        metadata.update(ciProvider="github_actions", ciActor=os.getenv("GITHUB_ACTOR"),
                        ciRunUrl=f"{server}/{repo}/actions/runs/{run}" if repo and run else None)
    elif os.getenv("CI"):
        metadata["ciProvider"] = "unknown"
    return metadata


def _print_check_report(report: dict, *, stdout=sys.stdout) -> None:
    print(f"tailplan {report.get('cliVersion', '0.3.0')} -> {report.get('apiUrl', '')}", file=stdout)
    if report.get("offline"):
        print(f"Offline: {report.get('networkError', 'server unreachable')}", file=stdout)
        print("Checked markup locally. Account and server limits were not checked.", file=stdout)
    elif report.get("limits"):
        account = report.get("account") or {}
        print(f"Account: {account.get('name', 'unknown')} (key: {account.get('apiKeyName', 'unknown')})", file=stdout)
        limits = report["limits"]
        print(f"Limit: {format_bytes(limits['maxBytes'])} per upload, {limits['maxPages']} page(s)", file=stdout)
        caps = report.get("capabilities") or {}
        print(f"Custom URLs: {'enabled' if caps.get('customUrls') else 'not enabled'}", file=stdout)
    if report.get("slug"):
        slug_info = report["slug"]
        msg = f". {slug_info['message']}" if slug_info.get("message") else ""
        print(f'Custom URL "{slug_info["slug"]}": {slug_info["status"]}{msg}', file=stdout)
    if report.get("path") and report.get("pages") is not None:
        count = len(report["pages"])
        label = f"{count} page" if count == 1 else f"{count} pages"
        print(f"\n{report['path']} ({label}, {format_bytes(report.get('totalBytes', 0))})", file=stdout)
    for issue in report.get("issues") or []:
        level = "Error" if issue.get("level") == "error" else "Warning"
        print(f"{level}: {format_issue(issue)}", file=stdout)
    if not report.get("issues"):
        for err in report.get("errors") or []:
            print(f"Error: {err}", file=stdout)
    print("\nReady." if report.get("ok") else "\nNot ready.", file=stdout)


def _write_new_file_nofollow(dest: Path, content: str) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    fd = os.open(dest, flags, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        raise


def write_downloaded_source(
    source: dict,
    *,
    base_url: str,
    state_dir: Path,
    cwd: Path | None = None,
    save_binding: bool = True,
) -> dict:
    """Write downloaded draft pages without overwriting existing files."""
    if not isinstance(source, dict):
        raise ConfigurationFailure("Server returned an invalid download payload.")
    draft_id = source.get("draftId")
    if not isinstance(draft_id, str) or DRAFT_ID_RE.fullmatch(draft_id) is None:
        raise ConfigurationFailure("Server returned an invalid draft ID.")
    slug = source.get("slug")
    if slug is not None and (not isinstance(slug, str) or slug_problem(slug) is not None):
        raise ConfigurationFailure("Server returned an invalid slug.")
    version_number = source.get("versionNumber")
    if type(version_number) is not int or not 1 <= version_number <= 999_999_999:
        raise ConfigurationFailure("Server returned an invalid version number.")
    pages = source.get("pages")
    if not isinstance(pages, list) or not pages:
        raise ConfigurationFailure("Server returned no pages to download.")
    seen_lower: set[str] = set()
    for page in pages:
        if not isinstance(page, dict) or page_path_problem(page.get("path")) is not None or not isinstance(page.get("html"), str):
            raise ConfigurationFailure("Server returned an invalid page entry.")
        lowered = page["path"].lower()
        if lowered in seen_lower:
            raise ConfigurationFailure("Server returned duplicate page paths.")
        seen_lower.add(lowered)
    base_dir = (cwd or Path.cwd()).resolve()
    name = slug or draft_id
    if len(pages) == 1:
        target = unique_path(base_dir / f"{name}-v{version_number}.html")
        if target.parent.resolve() != base_dir:
            raise ConfigurationFailure("Downloaded path escapes working directory.")
        _write_new_file_nofollow(target, pages[0]["html"])
    else:
        target = unique_path(base_dir / f"{name}-v{version_number}")
        if target.parent.resolve() != base_dir:
            raise ConfigurationFailure("Downloaded path escapes working directory.")
        target.mkdir(parents=True, exist_ok=False)
        for page in pages:
            dest = (target / page["path"]).resolve()
            if not dest.is_relative_to(target.resolve()):
                raise ConfigurationFailure("Downloaded page path escapes target folder.")
            dest.parent.mkdir(parents=True, exist_ok=True)
            _write_new_file_nofollow(dest, page["html"])
    ref = slug or draft_id
    public_url = f"{base_url.rstrip('/')}/d/{ref}"
    if save_binding and source.get("owned"):
        save_draft_binding(
            state_dir,
            base_url,
            target,
            {
                "draftId": draft_id,
                "slug": slug,
                "publicUrl": public_url,
                "versionNumber": version_number,
            },
        )
    rel = os.path.relpath(target, base_dir)
    upload_cmd = f"tailplan upload {shell_quote(rel)}" + ("" if source.get("owned") else " --new")
    return {
        "ok": True,
        "draftId": draft_id,
        "slug": slug,
        "title": source.get("title"),
        "versionNumber": version_number,
        "owned": bool(source.get("owned")),
        "path": str(target),
        "pages": [page["path"] for page in pages],
        "uploadCommand": upload_cmd,
    }


def management_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Manage Tailplan drafts and API keys.")
    commands = parser.add_subparsers(dest="command", required=True)

    def options(command):
        command.add_argument("--base-url", "--api-url", dest="base_url")
        command.add_argument("--json", action="store_true")
        command.add_argument("--allow-insecure-http", action="store_true")
        return command

    for name in ("whoami", "list", "themes", "typography"):
        options(commands.add_parser(name))
    check_cmd = options(commands.add_parser("check"))
    check_cmd.add_argument("file", nargs="?")
    check_cmd.add_argument("--slug")
    check_cmd.add_argument("--files-json", dest="files_json")
    for name in ("history", "disable", "enable", "delete", "favorite", "unfavorite"):
        command = options(commands.add_parser(name))
        command.add_argument("draft")
        if name == "disable":
            command.add_argument("--reason")
    download_cmd = options(commands.add_parser("download"))
    download_cmd.add_argument("draft")
    download_cmd.add_argument("--print-source", action="store_true", dest="print_source")
    auth = commands.add_parser("auth").add_subparsers(dest="action", required=True)
    options(auth.add_parser("login"))
    options(auth.add_parser("set")).add_argument("key", nargs="?")
    options(auth.add_parser("logout"))
    keys = commands.add_parser("keys").add_subparsers(dest="action", required=True)
    options(keys.add_parser("list"))
    options(keys.add_parser("create")).add_argument("name")
    options(keys.add_parser("revoke")).add_argument("key_id")
    args = parser.parse_args(argv)
    try:
        base = validate_base_url(args.base_url or os.getenv("TAILPLAN_BASE_URL") or default_base_url(),
                                 allow_insecure_http=args.allow_insecure_http)
        state = Path.home() / ".tailplan"
        token_path = Path(os.getenv("TAILPLAN_TOKEN_FILE", str(state / "token")))

        def read_credential(*, optional: bool = False) -> str:
            env_key = os.getenv("TAILPLAN_API_KEY")
            if env_key:
                return env_key
            try:
                return token_path.read_text(encoding="utf-8").strip()
            except FileNotFoundError:
                if optional:
                    return ""
                raise ConfigurationFailure(
                    "Tailplan token is missing; create ~/.tailplan/token, then retry."
                ) from None

        def request(path, method="GET", payload=None, token=None, *, optional_auth: bool = False):
            if path in {"/api/themes", "/api/typography"}:
                credential = ""
            elif token is not None:
                credential = token
            else:
                credential = read_credential(optional=optional_auth)
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8") if payload is not None else None
            headers = {
                "Content-Type": "application/json",
                "User-Agent": "tailplan/0.3.0",
            }
            if credential:
                headers["Authorization"] = "Bearer " + credential
            req = urllib.request.Request(base + path, data=body, method=method, headers=headers)
            try:
                with _open_without_redirects(req, timeout=20) as response:
                    result = json.loads(response.read())
                    if not isinstance(result, dict):
                        raise ConfigurationFailure("Server returned an invalid response.")
                    return result
            except urllib.error.HTTPError as error:
                raise ConfigurationFailure(_error_detail(error, sensitive=(credential,))) from None

        if args.command == "check":
            payload: dict = {}
            offline_pages: list[dict] | None = None
            display_path: str | None = None
            if args.files_json:
                source_path = Path(args.files_json).expanduser().resolve()
                offline_pages = _load_files_json(source_path)
                payload["files"] = offline_pages
                display_path = str(source_path)
            elif args.file:
                source_path = Path(args.file).expanduser().resolve()
                display_path = str(source_path)
                if not source_path.exists():
                    raise ConfigurationFailure(f"Path does not exist: {source_path}")
                if source_path.is_dir():
                    offline_pages = read_html_folder(source_path)
                    if not offline_pages:
                        raise ConfigurationFailure(f"No .html files found in {source_path}")
                    payload["files"] = offline_pages
                elif source_path.suffix.lower() in {".html", ".htm"}:
                    doc = source_path.read_bytes().decode("utf-8")
                    payload["html"] = doc
                    offline_pages = [{"path": "index.html", "html": doc}]
                elif source_path.suffix.lower() in {".md", ".txt"}:
                    text = source_path.read_text(encoding="utf-8")
                    payload["content"] = text
                    payload["filename"] = source_path.name
                    payload["format"] = "text" if source_path.suffix.lower() == ".txt" else "markdown"
                    rendered = html_document(title_from_content(source_path, text), markdown_to_body(text), source_path.name)
                    offline_pages = [{"path": "index.html", "html": rendered}]
                else:
                    raise ConfigurationFailure("Unsupported file type; use .md, .txt, .html, .htm, or a folder.")
            if args.slug is not None:
                payload["slug"] = args.slug.strip().lower()
            try:
                report = request("/api/check", "POST", payload)
            except (
                urllib.error.URLError,
                TimeoutError,
                ConnectionError,
                OSError,
                http.client.HTTPException,
            ) as net_error:
                report = {
                    "ok": False,
                    "offline": True,
                    "networkError": f"Could not reach {base}: {net_error}",
                }
                if offline_pages is not None:
                    local = validate_upload_offline(offline_pages)
                    report.update(
                        {
                            "markupOk": local["ok"],
                            "totalBytes": local["totalBytes"],
                            "pages": local["pages"],
                            "issues": local["issues"],
                            "errors": local["errors"],
                            "warnings": local["warnings"],
                        }
                    )
                if args.slug is not None:
                    slug_val = args.slug.strip().lower()
                    problem = slug_problem(slug_val)
                    report["slug"] = (
                        {"slug": slug_val, "status": "unavailable", "message": problem}
                        if problem
                        else {"slug": slug_val, "status": "unchecked", "message": "Availability was not checked offline."}
                    )
            report = {"cliVersion": "0.3.0", "apiUrl": base, **({"path": display_path} if display_path else {}), **report}
            if args.json:
                print(json.dumps(report, ensure_ascii=False))
            else:
                _print_check_report(report)
            return 0 if report.get("ok") else 1

        if args.command == "download":
            ref = parse_draft_ref(args.draft, base)
            source = request(f"/api/drafts/{ref}/source", optional_auth=True)
            if args.print_source:
                print(json.dumps(source, ensure_ascii=False))
                return 0
            receipt = write_downloaded_source(source, base_url=base, state_dir=state)
            if args.json:
                print(json.dumps(receipt, ensure_ascii=False))
            else:
                count = len(receipt["pages"])
                label = f"{count} page" if count == 1 else f"{count} pages"
                print(f"Downloaded {receipt['path']} ({label}, v{receipt['versionNumber']})")
                print(f"Upload: {receipt['uploadCommand']}")
            return 0

        if args.command == "auth":
            if args.action == "logout":
                token_path.unlink(missing_ok=True)
                result = {"ok": True, "message": "Local credentials removed."}
            else:
                key = getattr(args, "key", None)
                if not key:
                    if args.action == "login":
                        print(f"Open {base}/cli/auth\nGenerate a key, then paste it here.", file=sys.stderr)
                    key = getpass.getpass("API key: ") if sys.stdin.isatty() else sys.stdin.readline().strip()
                if not key:
                    raise ConfigurationFailure("No key entered. Nothing saved.")
                identity = request("/api/me", token=key)
                state.mkdir(mode=0o700, parents=True, exist_ok=True)
                os.chmod(state, 0o700)
                for path, text in ((token_path, key + "\n"), (state / "env", f'TAILPLAN_BASE_URL="{base}"\n')):
                    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=".auth-")
                    try:
                        with os.fdopen(fd, "w") as stream:
                            os.fchmod(stream.fileno(), 0o600)
                            stream.write(text)
                            stream.flush()
                            os.fsync(stream.fileno())
                        os.replace(temporary, path)
                    finally:
                        Path(temporary).unlink(missing_ok=True)
                result = {"ok": True, "message": f"Logged in as {identity['accountName']}.", **identity}
        elif args.command in {"themes", "typography"}:
            result = request("/api/" + args.command)
        elif args.command == "whoami":
            result = request("/api/me")
        elif args.command == "list":
            result = request("/api/drafts")
        elif args.command == "keys":
            if args.action == "list":
                result = request("/api/api-keys")
            elif args.action == "create":
                result = request("/api/api-keys", "POST", {"name": args.name})
            else:
                if DRAFT_ID_RE.fullmatch(args.key_id) is None:
                    raise ConfigurationFailure("API key ID is invalid.")
                result = request(f"/api/api-keys/{args.key_id}/revoke", "POST", {})
        elif args.command in {"favorite", "unfavorite"}:
            ref = parse_draft_ref(args.draft, base)
            fav = args.command == "favorite"
            result = request(f"/api/drafts/{ref}/favorite", "POST", {"favorite": fav})
            result["message"] = f"Added {ref} to favorites." if fav else f"Removed {ref} from favorites."
        else:
            ref = parse_draft_ref(args.draft, base)
            path = f"/api/drafts/{ref}"
            if args.command == "history":
                result = request(path)
            elif args.command == "delete":
                result = request(path, "DELETE")
            else:
                result = request(path + "/" + args.command, "POST", {"reason": getattr(args, "reason", None)})
        if args.json:
            print(json.dumps(result.get("drafts", result), ensure_ascii=False))
        elif args.command == "list":
            for draft in result["drafts"]:
                repo = "/".join(filter(None, (draft.get("repoOrg"), draft.get("repoName")))) or "No repository"
                prefix = "★ " if draft.get("favorite") else ""
                print(f"{prefix}{draft['title']}\n  {repo} · v{draft['latestVersionNumber']} · {draft['versionCount']} versions · {draft['updatedAt']}")
                print(f"  {draft.get('shareUrl') or draft['publicUrl']}")
                if draft.get("description"):
                    print(f"  {draft['description']}")
            if not result["drafts"]:
                print("No drafts yet. Publish with: tailplan upload FILE")
        elif result.get("message"):
            print(result["message"])
        else:
            print(json.dumps(result, indent=2, ensure_ascii=False))
        return 0
    except (ConfigurationFailure, OSError, ValueError, UnicodeError, http.client.HTTPException) as error:
        message = str(error) if isinstance(error, ConfigurationFailure) else "Request failed. Check credentials, configuration, and connectivity."
        return _emit_failure("management", message, json_output=args.json, stdout=sys.stdout, stderr=sys.stderr)


if __name__ == "__main__":
    raise SystemExit(main())
