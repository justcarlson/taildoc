#!/usr/bin/env python3
"""Run the Tailplan publishing and management CLI."""
import os
import runpy
import sys
from pathlib import Path

_SCRIPT = Path(__file__).resolve()
for _candidate in (
    _SCRIPT.parents[1],
    Path(os.getenv("TAILPLAN_SHARE_DIR", str(Path.home() / ".local" / "share" / "tailplan"))),
    Path("/usr/local/lib/tailplan"),
):
    if (_candidate / "tailplan_ui").is_dir() and str(_candidate) not in sys.path:
        sys.path.insert(0, str(_candidate))

if __name__ == "__main__":
    runpy.run_path(str(_SCRIPT.with_name("tailplan-share")), run_name="__main__")
