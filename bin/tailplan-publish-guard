#!/usr/bin/env python3
"""Allow the exact remote commands that the Tailplan OpenSSH client uses."""
from __future__ import annotations

import json
import os
import re
import shlex
import stat
import sys
from pathlib import Path

CONFIG_PATH = Path("/etc/tailplan-publisher.json")
DIRECTORY_RE = re.compile(r"/tmp/tailplan-upload\.[A-Za-z0-9]{8}")
FILE_RE = re.compile(
    r"(/tmp/tailplan-upload\.[A-Za-z0-9]{8})/([A-Za-z0-9_][A-Za-z0-9_.-]{0,254})"
)
DRAFT_RE = re.compile(r"[a-z0-9]{6,32}")
SLUG_RE = re.compile(r"[a-z0-9][a-z0-9-]{1,38}[a-z0-9]")
DRAFT_REF_RE = re.compile(r"[a-z0-9][a-z0-9-]{1,39}")
MAX_FILES_JSON_BYTES = 512 * 1024 * 6 + 64 * 1024
MAX_SHARING_ARGS = 64
# Sharing values. Each pattern refuses a leading "-", so no value reads as an option.
VISIBILITY_RE = re.compile(r"private|workspace|authenticated|link")
WORKSPACE_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,62}")
# An email needs a dotted domain. A dot-free login such as alice@github is a
# Tailscale login: use --grant-tailscale for it.
EMAIL_ARG_RE = re.compile(
    r"[A-Za-z0-9_%+'][A-Za-z0-9._%+'-]{0,63}"
    r"@(?=[A-Za-z0-9.-]{3,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+"
)
TAILSCALE_LOGIN_ARG_RE = re.compile(
    r"[A-Za-z0-9_%+'][A-Za-z0-9._%+'-]{0,63}@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?"
)
GROUP_ARG_RE = re.compile(r"[A-Za-z0-9/_][A-Za-z0-9 _./:@+-]{0,254}")
ROLE_RE = re.compile(r"viewer|editor")
SHARING_VALUES = {
    "--visibility": VISIBILITY_RE,
    "--workspace": WORKSPACE_RE,
    "--grant-email": EMAIL_ARG_RE,
    "--grant-tailscale": TAILSCALE_LOGIN_ARG_RE,
    "--grant-group": GROUP_ARG_RE,
    "--revoke-email": EMAIL_ARG_RE,
    "--revoke-tailscale": TAILSCALE_LOGIN_ARG_RE,
    "--revoke-group": GROUP_ARG_RE,
    "--role": ROLE_RE,
    "--grant-role": ROLE_RE,
}
REPEATABLE_OPTIONS = {
    "--grant-email", "--grant-tailscale", "--grant-group",
    "--revoke-email", "--revoke-tailscale", "--revoke-group",
}
SHARE_OPTIONS = {
    "--visibility", "--workspace", "--role",
    "--grant-email", "--grant-tailscale", "--grant-group",
    "--revoke-email", "--revoke-tailscale", "--revoke-group",
}
PUBLISH_SHARING_OPTIONS = {
    "--visibility", "--workspace", "--grant-role",
    "--grant-email", "--grant-tailscale", "--grant-group",
}


def deny(detail: str) -> None:
    print(f"tailplan-publish-guard: {detail}", file=sys.stderr)
    raise SystemExit(126)


def configured_share_command() -> str:
    try:
        config_stat = CONFIG_PATH.stat(follow_symlinks=False)
        config = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        deny(f"publisher configuration is not available: {error}")
    if not stat.S_ISREG(config_stat.st_mode) or config_stat.st_uid != 0:
        deny("publisher configuration must be a root-owned regular file")
    if config_stat.st_mode & 0o022:
        deny("publisher configuration must not be writable by group or other users")
    command = config.get("share_command") if isinstance(config, dict) else None
    if not isinstance(command, str) or not command.startswith("/"):
        deny("publisher command must be an absolute path")
    try:
        command_stat = os.stat(command, follow_symlinks=False)
    except OSError as error:
        deny(f"publisher command is not available: {error}")
    if not stat.S_ISREG(command_stat.st_mode) or command_stat.st_mode & 0o022:
        deny("publisher command must be a protected regular file")
    if not os.access(command, os.X_OK):
        deny("publisher command is not executable")
    return command


def parse_original_command() -> list[str]:
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    if not original or "\n" in original or "\r" in original or "\x00" in original:
        deny("SSH_ORIGINAL_COMMAND is missing or invalid")
    try:
        return shlex.split(original, posix=True)
    except ValueError:
        deny("SSH_ORIGINAL_COMMAND has invalid quoting")


def _verify_staged_file(path_str: str, *, max_size: int | None = None, label: str = "file") -> None:
    """Verify staged upload directory and file without following symlinks."""
    path = Path(path_str)
    parent = path.parent
    try:
        parent_stat = parent.stat(follow_symlinks=False)
    except OSError:
        deny(f"{label} directory is not available")
    if not stat.S_ISDIR(parent_stat.st_mode) or parent_stat.st_uid != os.getuid():
        deny(f"{label} directory has an invalid owner or type")
    try:
        info = path.stat(follow_symlinks=False)
    except OSError:
        deny(f"{label} is not available")
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        deny(f"{label} has an invalid owner or type")
    if max_size is not None and info.st_size > max_size:
        deny(f"{label} is too large")


def check_sharing_value(option: str, value: str) -> None:
    pattern = SHARING_VALUES[option]
    if pattern.fullmatch(value) is None:
        deny(f"{option} value is invalid")


def check_share_command(values: list[str]) -> None:
    """Allow `share REF` with sharing options. Deny everything else."""
    if len(values) < 2 or len(values) > MAX_SHARING_ARGS or DRAFT_REF_RE.fullmatch(values[1]) is None:
        deny("share arguments are invalid")
    rest = values[2:]
    seen: set[str] = set()
    while rest:
        option, *rest = rest
        if option == "--json":
            if option in seen:
                deny("duplicate share option")
            seen.add(option)
            continue
        if option not in SHARE_OPTIONS or not rest:
            deny("share option is invalid")
        if option in seen and option not in REPEATABLE_OPTIONS:
            deny("duplicate share option")
        seen.add(option)
        value, *rest = rest
        check_sharing_value(option, value)


def execute(argv: list[str]) -> None:
    if argv == ["mktemp", "-d", "/tmp/tailplan-upload.XXXXXXXX"]:
        os.execv("/usr/bin/mktemp", argv)

    if len(argv) == 3 and argv[:2] == ["scp", "-t"] and FILE_RE.fullmatch(argv[2]):
        parent = Path(argv[2]).parent
        try:
            parent_stat = parent.stat(follow_symlinks=False)
        except OSError:
            deny("upload directory is not available")
        if not stat.S_ISDIR(parent_stat.st_mode) or parent_stat.st_uid != os.getuid():
            deny("upload directory has an invalid owner or type")
        os.execv("/usr/bin/scp", argv)

    if argv and argv[0] == "tailplan-share" and len(argv) > 1 and argv[1] in {
        "list", "whoami", "history", "disable", "enable", "delete",
        "favorite", "unfavorite", "keys", "themes", "typography", "download", "check", "share",
    }:
        values = argv[1:]
        if values[0] == "share":
            check_share_command(values)
            command = configured_share_command()
            os.execv(command, [command, *argv[1:]])
        if values[0] == "check":
            rest = values[1:]
            seen_check: set[str] = set()
            source_path: str | None = None
            while rest:
                token, *rest = rest
                if token == "--json":
                    if token in seen_check:
                        deny("duplicate check option")
                    seen_check.add(token)
                elif token == "--slug":
                    if token in seen_check or not rest:
                        deny("invalid check slug")
                    seen_check.add(token)
                    slug_val, *rest = rest
                    if SLUG_RE.fullmatch(slug_val) is None:
                        deny("invalid check slug")
                elif token == "--files-json":
                    if token in seen_check or source_path is not None or not rest:
                        deny("invalid check files path")
                    seen_check.add(token)
                    source_path, *rest = rest
                    if FILE_RE.fullmatch(source_path) is None:
                        deny("invalid check files path")
                elif source_path is None and FILE_RE.fullmatch(token):
                    source_path = token
                else:
                    deny("check arguments are invalid")
            if source_path is not None:
                _verify_staged_file(source_path, max_size=MAX_FILES_JSON_BYTES, label="check source")
            command = configured_share_command()
            os.execv(command, [command, *argv[1:]])
        if values[0] == "download":
            if len(values) != 3 or DRAFT_REF_RE.fullmatch(values[1]) is None or values[2] != "--print-source":
                deny("download arguments are invalid")
            command = configured_share_command()
            os.execv(command, [command, *argv[1:]])
        if "--json" in values:
            values = [value for value in values if value != "--json"]
        valid = values in (["list"], ["whoami"], ["keys", "list"], ["themes"], ["typography"])
        if len(values) == 2 and values[0] in {"history", "disable", "enable", "delete", "favorite", "unfavorite"}:
            valid = DRAFT_REF_RE.fullmatch(values[1]) is not None
        if len(values) == 3 and values[:2] == ["keys", "revoke"]:
            valid = DRAFT_RE.fullmatch(values[2]) is not None
        if len(values) == 3 and values[:2] == ["keys", "create"]:
            valid = 0 < len(values[2]) <= 255 and not values[2].startswith("-")
        if len(values) == 4 and values[0] == "disable" and values[2] == "--reason":
            valid = DRAFT_REF_RE.fullmatch(values[1]) is not None and len(values[3]) <= 1000
        if not valid:
            deny("management arguments are invalid")
        command = configured_share_command()
        os.execv(command, [command, *argv[1:]])

    if 2 <= len(argv) <= 22 + MAX_SHARING_ARGS and argv[0] == "tailplan-share":
        if argv[1] == "--files-json":
            if len(argv) < 3 or FILE_RE.fullmatch(argv[2]) is None:
                deny("publish path is invalid")
            source_arg = argv[2]
            options = argv[3:]
        else:
            match = FILE_RE.fullmatch(argv[1])
            if match is None:
                deny("publish path is invalid")
            source_arg = argv[1]
            options = argv[2:]
        seen = set()
        while options:
            option, *options = options
            if option in seen and option not in REPEATABLE_OPTIONS:
                deny("duplicate publish option")
            seen.add(option)
            if option in {"--new", "--json"}:
                continue
            if option in PUBLISH_SHARING_OPTIONS:
                if not options:
                    deny("publish option is invalid")
                value, *options = options
                check_sharing_value(option, value)
                continue
            if option not in {
                "--draft", "--slug", "--description", "--metadata-file",
                "--theme", "--document-type", "--layout", "--typography",
            } or not options:
                deny("publish option is invalid")
            value, *options = options
            if option in {"--theme", "--document-type", "--layout", "--typography"} and not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", value):
                deny("theme option is invalid")
            if option == "--draft" and DRAFT_RE.fullmatch(value) is None:
                deny("draft option is invalid")
            if option == "--slug" and SLUG_RE.fullmatch(value) is None:
                deny("slug option is invalid")
            if option == "--description" and (len(value) > 1000 or value.startswith("-")):
                deny("description is invalid")
            if option == "--metadata-file":
                if value != str(Path(source_arg).parent / "provenance.json"):
                    deny("metadata path is invalid")
                _verify_staged_file(value, max_size=65536, label="metadata file")
        if {"--draft", "--new"}.issubset(seen) or {"--slug", "--new"}.issubset(seen):
            deny("draft options conflict")
        _verify_staged_file(
            source_arg,
            max_size=MAX_FILES_JSON_BYTES if argv[1] == "--files-json" else None,
            label="publish source",
        )
        command = configured_share_command()
        os.execv(command, [command, *argv[1:]])

    if len(argv) == 4 and argv[:3] == ["rm", "-rf", "--"]:
        directory = argv[3]
        if DIRECTORY_RE.fullmatch(directory) is None:
            deny("cleanup path is invalid")
        try:
            directory_stat = os.lstat(directory)
        except FileNotFoundError:
            raise SystemExit(0)
        except OSError:
            deny("cleanup path is not available")
        if not stat.S_ISDIR(directory_stat.st_mode) or directory_stat.st_uid != os.getuid():
            deny("cleanup directory has an invalid owner or type")
        os.execv("/usr/bin/rm", argv)

    deny("command is not allowed")


def main() -> int:
    execute(parse_original_command())
    return 126


if __name__ == "__main__":
    raise SystemExit(main())
